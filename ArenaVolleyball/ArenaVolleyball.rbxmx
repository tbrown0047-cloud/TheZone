HUD.cue = frame({ AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -210), Size = UDim2.fromOffset(380, 30), BackgroundColor3 = Color3.new(1, 1, 1), Visible = false }, hud)
gradient(HUD.cue, COL.violet, COL.bg1, 0)
