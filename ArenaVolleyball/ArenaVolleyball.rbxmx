-- touches used this possession
local dotsFrame = ui("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 56), Size = UDim2.fromOffset(44, 8), BackgroundTransparency = 1, Visible = false }, gui)
