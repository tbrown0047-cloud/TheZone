local HUD = { stamina = 1, power = nil }
HUD.gui = make("ScreenGui", {
	Name = "VolleyballHUD",
	ResetOnSpawn = false,
	IgnoreGuiInset = false,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
