			if live then
				Menu.chip(t, info[1] == "customise" and "OPEN" or "PLAY NOW", UDim2.new(0, 16, 1, -40))
			else
				Menu.chip(t, "COMING SOON", UDim2.new(0, 16, 1, -40), COL.text)
			end
		end
		Menu.hints(page, { { "CLICK", "Select" } })
	end
end

