<roblox version="4">
	<Item class="Folder" referent="RBX0">
		<Properties>
			<string name="Name">ArenaVolleyball</string>
		</Properties>
		<Item class="Script" referent="RBX1">
			<Properties>
				<string name="Name">Server</string>
				<ProtectedString name="Source"><![CDATA[-- ARENA VOLLEYBALL (server)
-- Builds the court, runs the rules, the ball and the AI players.
-- Settings are in the Config module next to this script.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterPlayer = game:GetService("StarterPlayer")

local pack = script.Parent
local Config = require(pack:WaitForChild("Config"))
local Teams = require(pack:WaitForChild("Teams"))
local clientTemplate = pack:WaitForChild("Client")

if ReplicatedStorage:FindFirstChild("ArenaVolleyball") then
	warn("[Arena Volleyball] Another copy is already running. Delete the extra ArenaVolleyball.")
	return
end

local TEAM_SIZE = math.clamp(math.floor(Config.TEAM_SIZE or 6), 1, 6)
local HALF_L = Config.COURT_LENGTH / 2
local HALF_W = Config.COURT_WIDTH / 2
local NET_H = Config.NET_HEIGHT
local G = Config.GRAVITY
local R = Config.BALL_RADIUS
local REACH = Config.REACH
local ATTACK_H = NET_H + 2 -- height a spike is hit at
-- How the AI plays at the bottom, middle and top of the skill range. A team's skill
-- (from its overall rating, see Teams.skill) blends between these.
local BASE_LEVELS = {
	{ speed = 14, react = 0.38, quality = 0.55, spike = 54, blockTry = 0.3, blockWin = 0.4, letGo = 0.4, serveLo = 0.35, serveHi = 0.7, margin = 4.5, fault = 0.07, attackErr = 0.16, shank = 0.1, jumpServe = 0.1 },
	{ speed = 17, react = 0.24, quality = 0.72, spike = 66, blockTry = 0.55, blockWin = 0.55, letGo = 0.75, serveLo = 0.45, serveHi = 0.82, margin = 3, fault = 0.04, attackErr = 0.09, shank = 0.05, jumpServe = 0.3 },
	{ speed = 20, react = 0.14, quality = 0.88, spike = 78, blockTry = 0.8, blockWin = 0.65, letGo = 0.92, serveLo = 0.55, serveHi = 0.9, margin = 1.8, fault = 0.025, attackErr = 0.05, shank = 0.02, jumpServe = 0.5 },
}
local function aiForSkill(skill)
	local a, b, t = BASE_LEVELS[1], BASE_LEVELS[2], skill * 2
	if skill > 0.5 then
		a, b, t = BASE_LEVELS[2], BASE_LEVELS[3], (skill - 0.5) * 2
	end
	local out = {}
	for key, value in a do
		out[key] = value + (b[key] - value) * t
	end
	return out
end
-- the menu sets these when someone starts a match
local pointsToWin = Config.POINTS_TO_WIN
local setsToWin = Config.SETS_TO_WIN

local rng = Random.new()

local function now()
	return workspace:GetServerTimeNow()
end

-- Team 1 plays on the +Z half, team 2 on the -Z half
local function side(team)
	return team == 1 and 1 or -1
end

local function flatDist(a, b)
	return Vector3.new(a.X - b.X, 0, a.Z - b.Z).Magnitude
end

-- Match state shared by every part of this script
local phase = "idle" -- idle, setup, serve, rally, point, setover, matchover
local matchActive = false -- no match runs until someone starts one from the menu
local servingTeam = 1
local serveAt, serveDeadline, phaseUntil = 0, 0, 0
local paused, pausedAt = false, 0 -- the pause menu really stops the match
local sendState, sendBall, currentServer, setupServe, stopMatch -- defined further down
local onMatchFinished -- career and online results, defined further down

---------------------------------------------------------------- court

local function findGround(pos)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = {}
	local hit = workspace:Raycast(pos + Vector3.new(0, 150, 0), Vector3.new(0, -300, 0), params)
	return hit and hit.Position.Y or pos.Y
end

local courtFolder = Instance.new("Folder")
courtFolder.Name = "VolleyballCourt"

local base = Config.COURT_CENTER
local groundY = findGround(base)
local GY = groundY + 0.44 -- top of the playing surface
local C = Vector3.new(base.X, GY, base.Z) -- centre of the court, on the floor

local function part(props)
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	if props.CanCollide ~= nil then
		p.CanCollide = props.CanCollide -- before CanQuery, which needs it off
	end
	for key, value in props do
		p[key] = value
	end
	p.Parent = courtFolder
	return p
end

-- floor: blue free zone around an orange court
part({
	Name = "FreeZone",
	Size = Vector3.new(Config.COURT_WIDTH + 36, 0.4, Config.COURT_LENGTH + 46), -- 5 m at the sides, 6.5 m at the ends
	CFrame = CFrame.new(C.X, groundY + 0.2, C.Z),
	Color = Color3.fromRGB(34, 74, 128),
})
part({
	Name = "Court",
	Size = Vector3.new(Config.COURT_WIDTH, 0.44, Config.COURT_LENGTH),
	CFrame = CFrame.new(C.X, groundY + 0.22, C.Z),
	Color = Color3.fromRGB(214, 128, 62),
})

local LINE = Color3.fromRGB(245, 245, 245)
local function line(name, size, offset, transparency)
	part({
		Name = name,
		Size = size,
		CFrame = CFrame.new(C + offset),
		Color = LINE,
		Transparency = transparency or 0,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		CastShadow = false,
	})
end
line("SideLine", Vector3.new(0.35, 0.06, Config.COURT_LENGTH + 0.35), Vector3.new(-HALF_W, 0, 0))
line("SideLine", Vector3.new(0.35, 0.06, Config.COURT_LENGTH + 0.35), Vector3.new(HALF_W, 0, 0))
line("EndLine", Vector3.new(Config.COURT_WIDTH + 0.35, 0.06, 0.35), Vector3.new(0, 0, -HALF_L))
line("EndLine", Vector3.new(Config.COURT_WIDTH + 0.35, 0.06, 0.35), Vector3.new(0, 0, HALF_L))
line("CentreLine", Vector3.new(Config.COURT_WIDTH, 0.06, 0.3), Vector3.zero)
local attack = Config.COURT_LENGTH / 6
line("AttackLine", Vector3.new(Config.COURT_WIDTH, 0.06, 0.3), Vector3.new(0, 0, attack), 0.35)
line("AttackLine", Vector3.new(Config.COURT_WIDTH, 0.06, 0.3), Vector3.new(0, 0, -attack), 0.35)

-- net, posts and antennas
for _, sx in { -1, 1 } do
	part({
		Name = "Post",
		Size = Vector3.new(0.6, NET_H + 1.5, 0.6),
		CFrame = CFrame.new(C.X + sx * (HALF_W + 3.6), GY + (NET_H + 1.5) / 2, C.Z),
		Color = Color3.fromRGB(60, 64, 72),
		Material = Enum.Material.Metal,
	})
	part({
		Name = "Antenna",
		Size = Vector3.new(0.18, 6.5, 0.18), -- 1.8 m, 0.8 m above the tape
		CFrame = CFrame.new(C.X + sx * HALF_W, GY + NET_H - 0.35, C.Z),
		Color = Color3.fromRGB(230, 60, 60),
		CanCollide = false,
		CastShadow = false,
	})
end
part({
	Name = "Net",
	Size = Vector3.new(Config.COURT_WIDTH + 6.5, 3.6, 0.12), -- 1 m tall mesh
	CFrame = CFrame.new(C.X, GY + NET_H - 2, C.Z),
	Color = Color3.fromRGB(235, 235, 235),
	Material = Enum.Material.Fabric,
	Transparency = 0.55,
	CastShadow = false,
})
part({
	Name = "NetBand",
	Size = Vector3.new(Config.COURT_WIDTH + 6.5, 0.4, 0.18),
	CFrame = CFrame.new(C.X, GY + NET_H - 0.2, C.Z),
	Color = Color3.fromRGB(250, 250, 250),
	CastShadow = false,
})
-- invisible wall so nobody walks or jumps onto the other side
part({
	Name = "Divider",
	Size = Vector3.new(Config.COURT_WIDTH + 60, 40, 0.6),
	CFrame = CFrame.new(C.X, GY + 20, C.Z),
	Transparency = 1,
	CastShadow = false,
})

-- stands with a crowd along both sidelines, and floodlights
do
	local crowdRng = Random.new(7)
	local CROWD = {
		Color3.fromRGB(220, 60, 60), Color3.fromRGB(60, 120, 230), Color3.fromRGB(240, 200, 60),
		Color3.fromRGB(240, 240, 240), Color3.fromRGB(40, 40, 50), Color3.fromRGB(60, 180, 110),
		Color3.fromRGB(200, 90, 200),
	}
	local standLength = Config.COURT_LENGTH + 30
	for _, sx in { -1, 1 } do
		for tier = 0, 4 do
			local height = 1.5 + tier * 1.6
			local x = C.X + sx * (HALF_W + 21 + tier * 3)
			part({
				Name = "Stand",
				Size = Vector3.new(3, height, standLength),
				CFrame = CFrame.new(x, groundY + height / 2, C.Z),
				Color = Color3.fromRGB(46, 50, 66),
				Material = Enum.Material.Concrete,
			})
			for k = 1, 20 do
				if crowdRng:NextNumber() < 0.8 then
					local z = C.Z - standLength / 2 + k * standLength / 21 + crowdRng:NextNumber(-0.6, 0.6)
					part({
						Name = "Fan",
						Size = Vector3.new(1.3, 2.3, 1.3),
						CFrame = CFrame.new(x, groundY + height + 1.15, z),
						Color = CROWD[crowdRng:NextInteger(1, #CROWD)],
						CanCollide = false,
						CanQuery = false,
						CanTouch = false,
					})
				end
			end
		end
	end
	for _, corner in { { -1, -1 }, { -1, 1 }, { 1, -1 }, { 1, 1 } } do
		local lamp = part({
			Name = "Floodlight",
			Size = Vector3.new(3, 1, 3),
			CFrame = CFrame.lookAt(Vector3.new(C.X + corner[1] * (HALF_W + 10), GY + 42, C.Z + corner[2] * (HALF_L - 6)), C) * CFrame.Angles(-math.pi / 2, 0, 0),
			Color = Color3.fromRGB(250, 248, 230),
			Material = Enum.Material.Neon,
			CanCollide = false,
			CastShadow = false,
		})
		local light = Instance.new("SpotLight")
		light.Face = Enum.NormalId.Top
		light.Angle = 70
		light.Range = 60
		light.Brightness = 2
		light.Parent = lamp
	end
end

---------------------------------------------------------------- shared objects for the client

local shared = Instance.new("Folder")
shared.Name = "ArenaVolleyball"
shared:SetAttribute("Center", C)
local remote = Instance.new("RemoteEvent")
remote.Name = "Remote"
remote.Parent = shared
local configCopy = pack.Config:Clone()
configCopy.Parent = shared
local teamsCopy = pack.Teams:Clone()
teamsCopy.Parent = shared
shared.Parent = ReplicatedStorage
courtFolder.Parent = workspace

---------------------------------------------------------------- teams, lineups and players

-- Each team has TEAM_SIZE slots, one per player in the lineup. A slot is played by a
-- person or by an AI body wearing that player's name and number.
local teams = {}
for t = 1, 2 do
	teams[t] = { id = t, slots = {}, score = 0, sets = 0, serveIndex = (t == 1) and 1 or 0, subs = 0 }
	for i = 1, TEAM_SIZE do
		teams[t].slots[i] = { team = t, index = i, isAI = true, ai = {} }
	end
end
local slotOfPlayer = {} -- the slot each person plays in (with his own character)
local controllers = {} -- people in the match: { team, home = slot index }
local charConnections = {}

local function tactic(team, key)
	local plan = teams[team].plan
	return plan and plan.tactics[key] or "BALANCED"
end

-- A team's AI strength from its lineup's rating, then its captain and tactics
local function applyPlan(t)
	local team = teams[t]
	team.lineup = team.plan.lineup
	team.rating = Teams.ratings(team.defId, team.lineup).OVR
	local ai = aiForSkill(Teams.skill(team.rating))
	if table.find(team.lineup, team.plan.captain) then
		ai.quality = math.min(ai.quality + 0.02, 0.95)
		ai.react = math.max(ai.react - 0.01, 0.1)
	end
	local block = team.plan.tactics.block
	if block == "READ" then
		ai.blockTry *= 0.7
		ai.blockWin = math.min(ai.blockWin * 1.15, 0.9)
	elseif block == "COMMIT" then
		ai.blockTry = math.min(ai.blockTry * 1.4, 0.97)
		ai.blockWin *= 0.9
	end
	team.ai = ai
end

-- Picks the clubs and their game plans (lineup, tactics and roles)
local function configureTeams(homeId, awayId, homePlan, awayPlan)
	for t, id in { homeId, awayId } do
		local team = teams[t]
		team.defId = id
		team.def = Teams.list[id]
		team.plan = Teams.cleanPlan(id, t == 1 and homePlan or awayPlan)
		team.subs = 0
		applyPlan(t)
	end
end
configureTeams(1, 2)

-- The libero the team has picked, if he's on the bench
local function liberoIndex(team)
	local index = team.plan and team.plan.libero
	local squad = Teams.squad(team.defId)
	if index and squad[index] and squad[index].role == "L" and not table.find(team.lineup, index) then
		return index
	end
	return nil
end

-- The squad player a slot stands for: a career player in your own slot, and the libero
-- in place of a middle blocker while he's in the back row (but not when he serves)
local function playerOf(slot)
	if slot.override then
		return slot.override
	end
	local team = teams[slot.team]
	local squad = Teams.squad(team.defId)
	local p = squad[team.lineup[slot.index] or slot.index]
	if TEAM_SIZE == 6 and p and p.role == "MB" then
		local pos = (slot.index - team.serveIndex) % 6 + 1
		local libero = (pos == 5 or pos == 6) and liberoIndex(team)
		if libero then
			return squad[libero]
		end
	end
	return p
end

local function roleOf(slot)
	local p = playerOf(slot)
	return p and p.role or "OH"
end

-- A player's attribute as 0..1 (50 or lower = 0, 100 = 1)
local function attr01(slot, attr)
	local p = playerOf(slot)
	return math.clamp(((p and p.attrs[attr] or 70) - 50) / 50, 0, 1)
end

local function teamAI(team)
	return teams[team].ai
end

-- Rotation position 1-6 (1 = back right, the server; 2 front right ... 6 back middle).
-- Players move round one place each time their team wins the serve back.
local function rotationPos(slot)
	return (slot.index - teams[slot.team].serveIndex) % 6 + 1
end

local function isFrontRow(slot)
	if TEAM_SIZE ~= 6 then
		return true
	end
	local pos = rotationPos(slot)
	return pos >= 2 and pos <= 4
end

-- Six-a-side spots: {across, as a share of half the width (+ = the team's right), distance from the net}
local SIX = {
	receive = { { 0.6, 0.72 }, { 0.65, 0.3 }, { 0, 0.2 }, { -0.65, 0.3 }, { -0.6, 0.72 }, { 0, 0.82 } },
	defend = { { 0.6, 0.7 }, { 0.55, 0.08 }, { 0, 0.08 }, { -0.55, 0.08 }, { -0.6, 0.7 }, { 0, 0.8 } },
}

-- Where a player stands while waiting
local function homeSpot(slot, mode)
	local s = side(slot.team)
	if TEAM_SIZE == 6 then
		local spot = SIX[mode == "receive" and "receive" or "defend"][rotationPos(slot)]
		local depth = spot[2]
		if mode ~= "receive" and depth > 0.5 then
			-- the back row's line comes from the team's defensive tactic
			local line = tactic(slot.team, "defense")
			depth += line == "DEEP" and 0.1 or line == "UP" and -0.14 or 0
		end
		-- facing the net, a team's right is +X for HOME and -X for AWAY
		return Vector3.new(C.X + s * spot[1] * HALF_W, GY, C.Z + s * math.max(depth * HALF_L, 2.5))
	end
	local x = 0
	if TEAM_SIZE > 1 then
		x = (-1 + 2 * (slot.index - 1) / (TEAM_SIZE - 1)) * HALF_W * 0.5
	end
	local depth = (mode == "serving") and HALF_L * 0.45 or HALF_L * 0.6
	return Vector3.new(C.X + x, GY, C.Z + s * depth)
end

local function serveSpot(slot)
	return Vector3.new(C.X + side(slot.team) * HALF_W * 0.45, GY, C.Z + side(slot.team) * (HALF_L + 3))
end

local function standHeight(slot)
	local hum, hrp = slot.humanoid, slot.root
	if hum and hrp then
		return GY + hum.HipHeight + hrp.Size.Y / 2
	end
	return GY + 3
end

-- Turns an AI body smoothly (it has its own turning instead of the humanoid's)
local function faceTowards(slot, dir)
	local flat = Vector3.new(dir.X, 0, dir.Z)
	if slot.align and flat.Magnitude > 0.05 then
		slot.align.CFrame = CFrame.lookAt(Vector3.zero, flat.Unit)
	end
end

local function placeSlot(slot, pos)
	local model = slot.model
	if not model or not slot.root then
		return
	end
	local p = Vector3.new(pos.X, standHeight(slot) + 0.2, pos.Z)
	local look = Vector3.new(C.X, p.Y, C.Z)
	model:PivotTo(CFrame.lookAt(p, look))
	faceTowards(slot, look - p)
	slot.ai.vel = Vector3.zero
	if slot.isAI and slot.humanoid then
		slot.humanoid:Move(Vector3.zero)
	end
end

local SKIN = {
	Color3.fromRGB(255, 220, 177),
	Color3.fromRGB(234, 192, 134),
	Color3.fromRGB(198, 134, 66),
	Color3.fromRGB(141, 85, 36),
	Color3.fromRGB(94, 58, 26),
}
-- Walk, run, idle, jump and fall for every body. Starts as Roblox's own; the server
-- swaps in Config.ANIMATION_PACK once it has loaded (see the start of the match code).
local PACK = {
	idle = "rbxassetid://507766666",
	walk = "rbxassetid://507777826",
	run = "rbxassetid://507767714",
	jump = "rbxassetid://507765000",
	fall = "rbxassetid://507767968",
}

-- Shirt numbers on the front and back
local function addNumber(model, number, color)
	local torso = model:FindFirstChild("UpperTorso") or model:FindFirstChild("Torso")
	if not torso then
		return
	end
	for _, face in { Enum.NormalId.Back, Enum.NormalId.Front } do
		local gui = Instance.new("SurfaceGui")
		gui.Name = "ShirtNumber"
		gui.Face = face
		gui.CanvasSize = Vector2.new(100, 100)
		gui.LightInfluence = 1
		local text = Instance.new("TextLabel")
		text.BackgroundTransparency = 1
		text.Size = face == Enum.NormalId.Back and UDim2.fromScale(1, 1) or UDim2.new(0.4, 0, 0.4, 0)
		text.Position = face == Enum.NormalId.Back and UDim2.new() or UDim2.fromScale(0.55, 0.12)
		text.Font = Enum.Font.GothamBold
		text.TextScaled = true
		text.TextColor3 = color
		text.Text = tostring(number)
		text.Parent = gui
		gui.Parent = torso
	end
end

-- Puts an AI body in the right shirt: the libero wears a contrasting one
local function dressBot(slot)
	local model = slot.model
	if not model then
		return
	end
	local def = teams[slot.team].def
	local p = playerOf(slot)
	local libero = p and p.role == "L"
	local shirtColor = libero and def.secondary or def.primary
	local colors = model:FindFirstChildOfClass("BodyColors")
	if colors then
		colors.TorsoColor3 = shirtColor
	end
	for _, name in { "UpperTorso", "LowerTorso", "Torso" } do
		local partInstance = model:FindFirstChild(name)
		if partInstance then
			partInstance.Color = shirtColor
		end
	end
	local light = (shirtColor.R + shirtColor.G + shirtColor.B) > 1.8
	for _, d in model:GetDescendants() do
		if d:IsA("SurfaceGui") and d.Name == "ShirtNumber" then
			local label = d:FindFirstChildOfClass("TextLabel")
			if label and p then
				label.Text = tostring(p.number)
				label.TextColor3 = light and Color3.fromRGB(20, 20, 30) or Color3.new(1, 1, 1)
			end
		end
	end
	if p then
		model.Name = p.last
	end
end

-- Used only if Roblox can't build a normal body
local function simpleBody(slot)
	local model = Instance.new("Model")
	local hrp = Instance.new("Part")
	hrp.Name = "HumanoidRootPart"
	hrp.Size = Vector3.new(2, 2, 1)
	hrp.Transparency = 1
	hrp.CFrame = CFrame.new(0, 3, 0)
	hrp.Parent = model
	local torso = Instance.new("Part")
	torso.Name = "Torso"
	torso.Size = Vector3.new(2, 2.6, 1)
	torso.Color = teams[slot.team].def.primary
	torso.CanCollide = false
	torso.Massless = true
	torso.CFrame = hrp.CFrame
	torso.Parent = model
	local head = Instance.new("Part")
	head.Name = "Head"
	head.Shape = Enum.PartType.Ball
	head.Size = Vector3.new(1.3, 1.3, 1.3)
	head.Color = SKIN[1]
	head.CanCollide = false
	head.Massless = true
	head.CFrame = hrp.CFrame * CFrame.new(0, 2, 0)
	head.Parent = model
	for _, p in { torso, head } do
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = hrp
		weld.Part1 = p
		weld.Parent = hrp
	end
	local hum = Instance.new("Humanoid")
	hum.RigType = Enum.HumanoidRigType.R15
	hum.HipHeight = 2
	hum.Parent = model
	model.PrimaryPart = hrp
	return model
end

local function makeBot(slot)
	local def = teams[slot.team].def
	local p = playerOf(slot)
	local desc = Instance.new("HumanoidDescription")
	local skin = SKIN[rng:NextInteger(1, #SKIN)]
	desc.HeadColor = skin
	desc.LeftArmColor = skin
	desc.RightArmColor = skin
	desc.TorsoColor = def.primary
	desc.LeftLegColor = def.secondary
	desc.RightLegColor = def.secondary
	local ok, model = pcall(Players.CreateHumanoidModelFromDescription, Players, desc, Enum.HumanoidRigType.R15)
	if not ok or not model then
		warn("[Arena Volleyball] Using a simple AI body: " .. tostring(model))
		model = simpleBody(slot)
	end
	-- a person may have taken this spot, or the match ended, while the body was made
	if not slot.isAI or slot.model or not matchActive then
		model:Destroy()
		return
	end
	model.Name = p and p.last or "PLAYER"
	local animate = model:FindFirstChild("Animate")
	if animate then
		animate:Destroy()
	end
	local hum = model:FindFirstChildOfClass("Humanoid")
	local hrp = model:FindFirstChild("HumanoidRootPart")
	if not hum or not hrp then
		model:Destroy()
		return
	end
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	hum.WalkSpeed = teamAI(slot.team).speed
	hum.UseJumpPower = true
	hum.JumpPower = 50
	hum.AutoRotate = false -- turning is done by the AlignOrientation below
	hum.BreakJointsOnDeath = false
	hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
	hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
	hum:SetStateEnabled(Enum.HumanoidStateType.Seated, false)
	hum:SetStateEnabled(Enum.HumanoidStateType.Climbing, false)
	model:SetAttribute("VolleyballAI", true)
	if p then
		local light = (def.primary.R + def.primary.G + def.primary.B) > 1.8
		addNumber(model, p.number, light and Color3.fromRGB(20, 20, 30) or Color3.new(1, 1, 1))
	end

	local attachment = Instance.new("Attachment")
	attachment.Name = "FaceAttachment"
	attachment.Parent = hrp
	local align = Instance.new("AlignOrientation")
	align.Name = "Facing"
	align.Mode = Enum.OrientationAlignmentMode.OneAttachment
	align.Attachment0 = attachment
	align.RigidityEnabled = false
	align.MaxTorque = 1e6
	align.Responsiveness = 14
	align.Parent = hrp

	slot.model, slot.humanoid, slot.root, slot.align = model, hum, hrp, align
	dressBot(slot)
	-- everyone moves a little differently
	slot.ai = { vel = Vector3.zero, pace = rng:NextNumber(0.88, 1.12), drift = rng:NextNumber(0, 10) }
	model.Parent = courtFolder
	if phase == "serve" and currentServer() == slot then
		placeSlot(slot, serveSpot(slot))
	else
		placeSlot(slot, homeSpot(slot))
	end
	pcall(function()
		hrp:SetNetworkOwner(nil)
	end)

	local animator = hum:FindFirstChildOfClass("Animator") or Instance.new("Animator")
	animator.Parent = hum
	slot.tracks = {}
	for name, id in PACK do
		local anim = Instance.new("Animation")
		anim.AnimationId = id
		local loaded, track = pcall(animator.LoadAnimation, animator, anim)
		if loaded and track then
			slot.tracks[name] = track
		end
	end
	slot.anim = nil
end

-- Plays idle / walk / run / jump on an AI body
local function animateBot(slot)
	local tracks, hum, hrp = slot.tracks, slot.humanoid, slot.root
	if not tracks or not hum or not hrp then
		return
	end
	local vel = hrp.AssemblyLinearVelocity
	local speed = Vector3.new(vel.X, 0, vel.Z).Magnitude
	local want = "idle"
	-- a body someone else controls is simulated on his screen, so check its height too
	if hum.FloorMaterial == Enum.Material.Air or hrp.Position.Y > standHeight(slot) + 0.8 then
		want = (vel.Y > 1 or not tracks.fall) and "jump" or "fall"
	elseif speed > 10 then
		want = "run"
	elseif speed > 1.2 then
		want = "walk"
	end
	if want ~= slot.anim then
		if slot.anim and tracks[slot.anim] then
			tracks[slot.anim]:Stop(0.2)
		end
		if tracks[want] then
			tracks[want]:Play(0.2)
		end
		slot.anim = want
	end
	if want == "run" and tracks.run then
		tracks.run:AdjustSpeed(math.clamp(speed / 18, 0.7, 1.5))
	elseif want == "walk" and tracks.walk then
		tracks.walk:AdjustSpeed(math.clamp(speed / 8, 0.5, 1.4))
	end
end

local function clearBody(slot)
	if slot.isAI and slot.model then
		slot.model:Destroy()
	end
	slot.model, slot.humanoid, slot.root, slot.tracks, slot.anim, slot.align = nil, nil, nil, nil, nil, nil
	slot.ai = {}
end

local function bindCharacter(slot, plr, char)
	local hum = char:WaitForChild("Humanoid", 10)
	local hrp = char:WaitForChild("HumanoidRootPart", 10)
	if slot.player ~= plr or not hum or not hrp then
		return
	end
	slot.model, slot.humanoid, slot.root = char, hum, hrp
	task.wait(0.15)
	if slot.player ~= plr or slot.model ~= char then
		return
	end
	if phase == "serve" and currentServer() == slot then
		placeSlot(slot, serveSpot(slot))
	else
		placeSlot(slot, homeSpot(slot))
	end
end

local function anyPeople()
	return next(controllers) ~= nil
end

-- Puts a person in a slot with his own character: the one asked for if an AI has it,
-- else the first AI slot on that team, else on the other team
local function addPlayer(plr, wantTeam, wantIndex)
	if slotOfPlayer[plr] then
		return slotOfPlayer[plr]
	end
	local slot
	local order = (wantTeam == 2) and { 2, 1 } or { 1, 2 }
	for _, t in order do
		local preferred = wantIndex and teams[t].slots[wantIndex]
		if t == order[1] and preferred and preferred.isAI then
			slot = preferred
		end
		for _, s in teams[t].slots do
			if s.isAI and not slot then
				slot = s
			end
		end
		if slot then
			break
		end
	end
	if not slot then
		return nil
	end
	clearBody(slot)
	slot.isAI = false
	slot.player = plr
	slot.stats = slot.stats or { kills = 0, aces = 0, blocks = 0, digs = 0 }
	slotOfPlayer[plr] = slot
	controllers[plr] = { team = slot.team, home = slot.index }
	if charConnections[plr] then
		charConnections[plr]:Disconnect()
	end
	charConnections[plr] = plr.CharacterAdded:Connect(function(char)
		bindCharacter(slot, plr, char)
	end)
	if plr.Character then
		task.spawn(bindCharacter, slot, plr, plr.Character)
	end
	if phase == "serve" and currentServer() == slot then
		serveDeadline = now() + Config.SERVE_TIME
	end
	sendState()
	return slot
end

local function removePlayer(plr)
	if charConnections[plr] then
		charConnections[plr]:Disconnect()
		charConnections[plr] = nil
	end
	controllers[plr] = nil
	local slot = slotOfPlayer[plr]
	if not slot then
		return
	end
	slotOfPlayer[plr] = nil
	slot.player = nil
	slot.override = nil
	-- forget the character so it isn't destroyed with the body
	slot.model, slot.humanoid, slot.root, slot.align = nil, nil, nil, nil
	slot.isAI = true
	slot.ai = {}
	if matchActive and not anyPeople() then
		stopMatch() -- nobody left playing: back to the menu
		return
	end
	if phase == "serve" and currentServer() == slot then
		serveAt = now() + 2.5
	end
	if matchActive then
		task.spawn(makeBot, slot)
	end
	sendState()
end

---------------------------------------------------------------- the ball
-- The ball is pure maths: a start point, a velocity and a start time. Clients draw it
-- from the same numbers, so it looks smooth for everyone and the server decides points.

local ball = {
	id = 0,
	mode = "rest", -- hold, fly, rest
	p0 = C + Vector3.new(0, R, 0),
	v0 = Vector3.zero,
	t0 = 0,
	netDone = false,
	bounces = 0,
	live = false,
	lastTeam = 0,
	lastSlot = nil,
	lastKind = nil,
	touches = 0,
	holder = nil,
	restPos = C + Vector3.new(0, R, 0),
}

local GV = Vector3.new(0, -G, 0)
local FLOOR = GY + R -- ball centre height when it touches the floor

local function ballPos(t)
	local dt = t - ball.t0
	return ball.p0 + ball.v0 * dt + GV * (0.5 * dt * dt)
end

local function ballVel(t)
	return ball.v0 + GV * (t - ball.t0)
end

-- Time when the ball comes down through height h, or nil if it never gets that high
local function heightTime(h)
	local vy = ball.v0.Y
	local disc = vy * vy + 2 * G * (ball.p0.Y - h)
	if disc < 0 then
		return nil
	end
	return ball.t0 + (vy + math.sqrt(disc)) / G
end

local function landTime()
	return math.max(heightTime(FLOOR) or ball.t0, ball.t0)
end

local function netTime()
	if ball.netDone or math.abs(ball.v0.Z) < 1e-3 then
		return math.huge
	end
	local s = (C.Z - ball.p0.Z) / ball.v0.Z
	if s <= 1e-4 then
		return math.huge
	end
	return ball.t0 + s
end

local function ballPacket()
	local holder = nil
	if ball.mode == "hold" and ball.holder then
		holder = ball.holder.model
	end
	return {
		id = ball.id,
		mode = ball.mode,
		p0 = ball.p0,
		v0 = ball.v0,
		t0 = ball.t0,
		rest = ball.restPos,
		holder = holder,
	}
end

function sendBall(plr)
	if plr then
		remote:FireClient(plr, "ball", ballPacket())
	else
		remote:FireAllClients("ball", ballPacket())
	end
end

local function launch(p, v, t, netDone, keepBounces)
	if p.Y < FLOOR + 0.05 then
		p = Vector3.new(p.X, FLOOR + 0.05, p.Z)
	end
	ball.id += 1
	ball.mode = "fly"
	ball.p0, ball.v0, ball.t0 = p, v, t
	ball.netDone = netDone == true
	if not keepBounces then
		ball.bounces = 0
		ball.netHit = false
		ball.power = false
	end
	sendBall()
end

local function banner(title, sub, team)
	remote:FireAllClients("banner", title, sub or "", team or 0)
end

---------------------------------------------------------------- aiming helpers

-- Velocity that carries the ball from p to target in tau seconds
local function solve(p, target, tau)
	return (target - p) / tau + Vector3.new(0, 0.5 * G * tau, 0)
end

local function clearsNet(p, v)
	if math.abs(v.Z) < 1e-3 then
		return true
	end
	local s = (C.Z - p.Z) / v.Z
	if s <= 0 then
		return true
	end
	local y = p.Y + v.Y * s - 0.5 * G * s * s
	return y >= GY + NET_H + R + 0.25
end

-- Like solve, but floats the ball a little higher until it clears the net
local function solveOver(p, target, tau, maxTau)
	local v = solve(p, target, tau)
	while not clearsNet(p, v) and tau < maxTau do
		tau += 0.05
		v = solve(p, target, tau)
	end
	return v
end

local function jitter(radius)
	local a = rng:NextNumber(0, math.pi * 2)
	local r = radius * math.sqrt(rng:NextNumber())
	return Vector3.new(math.cos(a) * r, 0, math.sin(a) * r)
end

-- A point on team's half: lx across the court, lz = distance from the net
local function floorPoint(team, lx, lz)
	return Vector3.new(C.X + lx, FLOOR, C.Z + side(team) * lz)
end

local function setSpot(team)
	return floorPoint(team, 0, 4.5) + Vector3.new(0, 6, 0)
end

-- The teammate a set goes to: people first, then whoever is nearest the net
-- Lanes hitters attack from, across the court from the team's point of view
local LANE = { OH = -1, OPP = 1, MB = 0 }
local SET_WEIGHT = { OH = 4, OPP = 3, MB = 2 }

-- How often the setter looks for a hitter: his role, the team's set distribution,
-- and the go-to hitter and quick attacker roles
local function setWeight(slot)
	local role = roleOf(slot)
	local w = SET_WEIGHT[role]
	if not w then
		return nil
	end
	local team = teams[slot.team]
	local plan = team.plan
	if not plan then
		return w
	end
	local focus = plan.tactics.focus
	if (focus == "OUTSIDE" and role == "OH") or (focus == "MIDDLE" and role == "MB") or (focus == "OPPOSITE" and role == "OPP") then
		w *= 2.5
	end
	local index = team.lineup[slot.index]
	if not slot.override and index == plan.goto then
		local late = math.max(team.score, teams[3 - slot.team].score) >= pointsToWin - 5
		w *= late and 3.5 or 2.2
	end
	if role == "MB" and index == plan.quick then
		w *= 1.8
	end
	return w
end

-- The teammate a set goes to: someone who called for it, a person on the team,
-- otherwise a front-row hitter picked by the team's tactics and roles
local function partnerOf(slot)
	local call = teams[slot.team].call
	if call and call.untilT > now() and call.slot ~= slot and call.slot.root then
		return call.slot, true
	end
	local options, weights, total, person = {}, {}, 0, nil
	for _, s in teams[slot.team].slots do
		if s ~= slot and s.root then
			if not s.isAI and not person and roleOf(s) ~= "L" then
				person = s
			end
			local w = isFrontRow(s) and setWeight(s)
			if w then
				table.insert(options, s)
				table.insert(weights, w)
				total += w
			end
		end
	end
	if person then
		return person
	end
	if #options > 0 then
		local pick = rng:NextNumber(0, total)
		for i, s in options do
			pick -= weights[i]
			if pick <= 0 then
				return s
			end
		end
		return options[#options]
	end
	-- nobody in the front row: whoever is nearest the net
	local best, bestZ = nil, math.huge
	for _, s in teams[slot.team].slots do
		if s ~= slot and s.root and math.abs(s.root.Position.Z - C.Z) < bestZ then
			best, bestZ = s, math.abs(s.root.Position.Z - C.Z)
		end
	end
	return best or slot
end

-- Where a set to this attacker is played: his lane, or where a person is standing
local function attackSpot(team, attacker)
	local s = side(team)
	local lx = s * HALF_W * 0.6 * -1
	if attacker and attacker.root then
		if attacker.isAI and TEAM_SIZE == 6 then
			lx = s * HALF_W * 0.6 * (LANE[roleOf(attacker)] or -1)
		else
			lx = math.clamp(attacker.root.Position.X - C.X, -HALF_W + 3, HALF_W - 3)
		end
	end
	return floorPoint(team, lx, 3.5) + Vector3.new(0, ATTACK_H - R, 0)
end

-- How hard a spike is hit: AI from the team's level, people from timing; both lifted by attack rating
local function spikeSpeed(slot, q)
	local attack = attr01(slot, "ATK")
	if slot.isAI then
		return teamAI(slot.team).spike * (0.82 + 0.36 * attack)
	end
	return (62 + 26 * q) * (0.9 + 0.2 * attack)
end

-- Animation cue for every player's screen
local function act(slot, kind)
	if slot and slot.model then
		remote:FireAllClients("act", slot.model, kind)
	end
end

---------------------------------------------------------------- abilities
-- Good plays fill a player's meter. When it's full, the ability (R) powers up his next move:
--   POWER SPIKE (hitters): a much harder spike that's hard to block and hard to dig
--   PERFECT SET (setters): a perfect set, and the hitter gets a power spike
--   IRON WALL (middles): for 9 seconds every block he gets to is a stuff block
--   SAFE HANDS (libero): for 9 seconds more reach and clean digs
--   ACE SERVE (whoever is serving): a fast, flat serve that's hard to pass

local ABILITY = { OH = "POWER SPIKE", OPP = "POWER SPIKE", MB = "IRON WALL", S = "PERFECT SET", L = "SAFE HANDS" }

local function abilityOf(slot)
	if phase == "serve" and currentServer() == slot then
		return "ACE SERVE"
	end
	return ABILITY[roleOf(slot)] or "POWER SPIKE"
end

local function charge(slot, amount)
	if slot then
		slot.meter = math.min(100, (slot.meter or 0) + amount * (Config.ABILITY_CHARGE or 1))
	end
end

local function boosted(slot, kind)
	local b = slot and slot.boost
	return b ~= nil and b.kind == kind and b.untilT > now()
end

local function spendBoost(slot)
	local b = slot.boost
	if b and b.uses then
		b.uses -= 1
		if b.uses <= 0 then
			slot.boost = nil
		end
	end
end

local function activateAbility(slot)
	if (slot.meter or 0) < 100 then
		return false
	end
	local kind = abilityOf(slot)
	slot.meter = 0
	if kind == "IRON WALL" or kind == "SAFE HANDS" then
		slot.boost = { kind = kind, untilT = now() + 9 }
	else
		slot.boost = { kind = kind, uses = 1, untilT = now() + 25 }
	end
	remote:FireAllClients("fx", "ability", slot.model, { kind = kind, team = slot.team, index = slot.index })
	sendState()
	return true
end

-- Keeps an aim point on the other half, at most `margin` studs past the lines
local function clampToOpp(team, aim, margin)
	local s = side(3 - team)
	local lx = math.clamp(aim.X - C.X, -HALF_W - margin, HALF_W + margin)
	local lz = (aim.Z - C.Z) * s
	if lz < 0 then
		lz = HALF_L * 0.55
	end
	lz = math.clamp(lz, 2, HALF_L + margin)
	return Vector3.new(C.X + lx, FLOOR, C.Z + s * lz)
end

local function randomOpp(team, margin)
	return floorPoint(3 - team, rng:NextNumber(-HALF_W + margin, HALF_W - margin), rng:NextNumber(margin + 2, HALF_L - margin))
end

-- Picks an open spot on the other half, away from the defenders
local function smartTarget(team, margin)
	local best, bestD = nil, -1
	for _ = 1, 6 do
		local pnt = randomOpp(team, margin)
		local d = 99
		for _, s in teams[3 - team].slots do
			if s.root then
				d = math.min(d, flatDist(s.root.Position, pnt))
			end
		end
		if d > bestD then
			best, bestD = pnt, d
		end
	end
	return best
end

---------------------------------------------------------------- rules

local function nextTouchNo(team)
	if ball.lastTeam == team then
		return ball.touches + 1
	end
	return 1
end

local function awardPoint(winner, reason)
	if not ball.live then
		return
	end
	ball.live = false
	local w, l = teams[winner], teams[3 - winner]
	w.score += 1
	if servingTeam ~= winner then
		servingTeam = winner
		w.serveIndex = w.serveIndex % TEAM_SIZE + 1
	end
	if w.score >= pointsToWin and w.score - l.score >= Config.WIN_BY then
		w.sets += 1
		if w.sets >= setsToWin then
			phase, phaseUntil = "matchover", now() + 9
			banner(teams[winner].def.name .. " WIN", "FULL TIME   ·   " .. w.score .. " - " .. l.score, winner)
		else
			phase, phaseUntil = "setover", now() + 5
			banner(teams[winner].def.name .. " TAKE THE SET", w.score .. " - " .. l.score, winner)
		end
	else
		phase, phaseUntil = "point", now() + 3.4
		banner(teams[winner].def.short .. " POINT", reason, winner)
	end
	sendState()
end

-- Can this player play the ball from here? Returns ok and a timing quality 0..1.
local function reachCheck(slot, kind, rootPos, bp, airborne, t)
	if (bp.Z - C.Z) * side(slot.team) < -1.5 then
		return false -- the ball is over the other side
	end
	local d = bp - rootPos
	local flat = Vector3.new(d.X, 0, d.Z).Magnitude
	local reach = REACH + ((slot.diveUntil or 0) > t and 3.5 or 0) + (slot.isAI and 0 or 1.5) + (boosted(slot, "SAFE HANDS") and 3 or 0)
	if flat > reach then
		return false
	end
	local lo, hi, ideal
	if kind == "spike" or kind == "tip" then
		if not airborne then
			return false
		end
		lo, hi, ideal = -2.5, 8, 3
	elseif kind == "set" then
		lo, hi, ideal = -2, 7, 3
	else
		lo, hi, ideal = -3.5, 5, 0
	end
	if d.Y < lo or d.Y > hi then
		return false
	end
	local q = 1 - (flat / reach) * 0.45 - math.clamp(math.abs(d.Y - ideal) / 6, 0, 1) * 0.35
	if kind == "bump" then
		local speed = ballVel(t).Magnitude
		if speed > 45 then
			q -= math.min((speed - 45) / 90, 0.35) -- hard spikes are harder to pass
		end
		if ball.power then
			q -= 0.25 -- power spikes and ace serves are harder still
		end
		if boosted(slot, "SAFE HANDS") then
			q = math.max(q, 0.82)
		end
	end
	return true, math.clamp(q, 0.05, 1)
end

-- A pass or set may drift, but it stays on the passer's side of the net
local function ownSide(team, p, minLz)
	local s = side(team)
	if (p.Z - C.Z) * s < minLz then
		return Vector3.new(p.X, p.Y, C.Z + s * minLz)
	end
	return p
end

-- Works out where a touch sends the ball
local function shotFor(slot, kind, p, aim, q, touchNo)
	local team = slot.team
	if (kind == "bump" or kind == "set") and touchNo >= 3 then
		-- third touch has to go over
		local target = clampToOpp(team, (aim and clampToOpp(team, aim, 0) or randomOpp(team, 4)) + jitter((1 - q) * 8), 1)
		return solveOver(p, target, 1.25, 2.2), "over"
	elseif kind == "bump" then
		return solve(p, ownSide(team, setSpot(team) + jitter((1 - q) * 9), 1.5), 1.25), "bump"
	elseif kind == "set" then
		local hitter, called = partnerOf(slot)
		local tempo = tactic(team, "tempo")
		local quick = called or (hitter.isAI and roleOf(hitter) == "MB" and TEAM_SIZE == 6 and tempo ~= "HIGH")
		teams[team].call = nil
		if boosted(slot, "PERFECT SET") then
			spendBoost(slot)
			q = 1
			hitter.boost = { kind = "POWER SPIKE", uses = 1, untilT = now() + 6 }
		end
		-- the attack tempo tactic: fast sets are flatter and harder to place, high ones safer
		local tau = quick and (tempo == "FAST" and 0.72 or 0.8) or (tempo == "FAST" and 1 or tempo == "HIGH" and 1.35 or 1.15)
		local spread = tempo == "FAST" and 7 or tempo == "HIGH" and 4.5 or 6
		return solve(p, ownSide(team, attackSpot(team, hitter) + jitter((1 - q) * spread), 1.5), tau), "set"
	elseif kind == "tip" then
		local target = aim and clampToOpp(team, aim, 0)
			or floorPoint(3 - team, rng:NextNumber(-HALF_W + 3, HALF_W - 3), rng:NextNumber(3, 9))
		return solveOver(p, target + jitter((1 - q) * 3), 0.8, 1.6), "tip"
	end
	local power = boosted(slot, "POWER SPIKE")
	if power then
		spendBoost(slot)
	end
	local target = clampToOpp(team, aim or randomOpp(team, 3), 3) + jitter((1 - q) * (power and 2.5 or 7))
	local speed = spikeSpeed(slot, q) * (power and 1.3 or 1)
	local flat = Vector3.new(target.X - p.X, 0, target.Z - p.Z).Magnitude
	return solveOver(p, target, math.max(flat / speed, 0.24), 1.3), "spike", power
end

local function touch(slot, kind, p, t, aim, q)
	local team = slot.team
	local n = nextTouchNo(team)
	if TEAM_SIZE > 1 and ball.lastSlot == slot then
		awardPoint(3 - team, "DOUBLE TOUCH")
		return false
	end
	if n > 3 then
		awardPoint(3 - team, "FOUR HITS")
		return false
	end
	-- rotation rules: back-row players attack from behind the 3 m line, the libero never above the net
	if TEAM_SIZE == 6 and kind == "spike" and p.Y > GY + NET_H then
		local libero = roleOf(slot) == "L"
		if libero or (not isFrontRow(slot) and (p.Z - C.Z) * side(team) < Config.COURT_LENGTH / 6) then
			awardPoint(3 - team, libero and "LIBERO ATTACK" or "BACK-ROW ATTACK")
			return false
		end
	end
	local v, shot, power = shotFor(slot, kind, p, aim, q, n)
	if n == 1 and ball.lastKind == "spike" then
		if slot.stats then
			slot.stats.digs += 1
		end
		charge(slot, 8)
	end
	charge(slot, q >= 0.85 and 12 or q >= 0.7 and 5 or 0)
	ball.touches, ball.lastTeam, ball.lastSlot, ball.lastKind = n, team, slot, shot
	slot.lastTouch = now()
	launch(p, v, t)
	ball.power = power == true
	act(slot, kind)
	remote:FireAllClients("fx", "hit", p, { kind = shot, q = q, user = slot.player and slot.player.UserId or 0, team = team, index = slot.index, power = ball.power, speed = v.Magnitude })
	sendState()
	return true
end

-- Someone on `team` jumping at the net in front of the ball?
local function findBlocker(team, p)
	local s = side(team)
	for _, sl in teams[team].slots do
		local hrp = sl.root
		-- only the front row may block, and never the libero
		local legal = TEAM_SIZE ~= 6 or (isFrontRow(sl) and roleOf(sl) ~= "L")
		if hrp and sl.humanoid and legal then
			local rp = hrp.Position
			local depth = (rp.Z - C.Z) * s
			local airborne = rp.Y > standHeight(sl) + 1
			local wall = boosted(sl, "IRON WALL")
			local width = wall and 5.3 or 3.8
			if airborne and depth > -0.5 and depth < 5 and math.abs(rp.X - p.X) < width and p.Y < rp.Y + 5.5 and p.Y > rp.Y - 1 then
				local win = math.min(teamAI(team).blockWin * (0.7 + 0.6 * attr01(sl, "BLK")), 0.92)
				if not sl.isAI then
					win = 1
				end
				if ball.power then
					win *= 0.35 -- a power spike usually breaks through
				end
				if wall or rng:NextNumber() <= win then
					return sl
				end
			end
		end
	end
	return nil
end

local function doBlock(blocker, p, v, t)
	if blocker.stats then
		blocker.stats.blocks += 1
	end
	charge(blocker, 15)
	local back = -side(blocker.team) -- towards the attackers
	local np, nv
	if boosted(blocker, "IRON WALL") or rng:NextNumber() < 0.6 then
		-- stuff block: straight back down on the attackers
		np = Vector3.new(p.X, p.Y, C.Z + back * (R + 0.3))
		nv = Vector3.new(v.X * 0.2 + rng:NextNumber(-4, 4), -6, back * rng:NextNumber(10, 18))
	else
		-- soft block: pops up on the blockers' side, still playable
		np = Vector3.new(p.X, p.Y, C.Z - back * (R + 0.3))
		nv = Vector3.new(rng:NextNumber(-3, 3), 20, -back * rng:NextNumber(5, 10))
	end
	-- a block isn't one of the three touches, and the blocker may play the ball next
	ball.lastTeam, ball.lastSlot, ball.touches, ball.lastKind = blocker.team, nil, 0, "block"
	ball.blocker = blocker
	launch(np, nv, t, true)
	remote:FireAllClients("fx", "block", np, {})
	sendState()
end

local function onNet(t)
	local p, v = ballPos(t), ballVel(t)
	local into = v.Z < 0 and 2 or 1 -- the team whose half the ball is heading into
	local s = side(into)
	if math.abs(p.X - C.X) > HALF_W + 0.5 then
		ball.netDone = true
		if ball.live then
			awardPoint(3 - ball.lastTeam, "OUTSIDE THE ANTENNA")
		end
		return
	end
	local h = p.Y - GY
	if h < NET_H - R then
		-- into the net: it drops back on the side it came from
		local np = Vector3.new(p.X, p.Y, C.Z - s * (R + 0.15))
		local nv = Vector3.new(v.X * 0.25, math.min(v.Y, 0) * 0.2 - 2, -s * math.abs(v.Z) * 0.15)
		launch(np, nv, t, true, true)
		ball.netHit = true
		remote:FireAllClients("fx", "net", np, {})
		return
	end
	if ball.live and ball.lastKind == "spike" then
		local blocker = findBlocker(into, p)
		if blocker then
			doBlock(blocker, p, v, t)
			return
		end
	end
	if h < NET_H + R then
		-- clips the tape and dribbles over
		local np = Vector3.new(p.X, GY + NET_H + R, C.Z + s * 0.05)
		local nv = Vector3.new(v.X * 0.6, math.abs(v.Y) * 0.3 + 3, v.Z * 0.45)
		launch(np, nv, t, true, true)
		remote:FireAllClients("fx", "net", np, {})
		return
	end
	ball.netDone = true
end

local function onLand(t)
	local p, v = ballPos(t), ballVel(t)
	local landP = Vector3.new(p.X, FLOOR, p.Z)
	if ball.live then
		local lx, lz = p.X - C.X, p.Z - C.Z
		local inside = math.abs(lx) <= HALF_W + R * 0.5 and math.abs(lz) <= HALF_L + R * 0.5
		if inside then
			local winner = lz > 0 and 2 or 1
			local reason = "IN"
			if ball.lastTeam == winner then
				if ball.lastKind == "serve" then
					reason = "ACE"
					charge(ball.lastSlot, 25)
					if ball.lastSlot and ball.lastSlot.stats then
						ball.lastSlot.stats.aces += 1
					end
				elseif ball.lastKind == "spike" then
					reason = "KILL"
					charge(ball.lastSlot, 20)
					if ball.lastSlot and ball.lastSlot.stats then
						ball.lastSlot.stats.kills += 1
					end
				elseif ball.lastKind == "block" then
					reason = "BLOCK"
					charge(ball.blocker, 15)
				elseif ball.lastKind == "tip" then
					reason = "TIP"
				end
			else
				-- it fell on the side of the team that touched it last
				reason = ball.netHit and "INTO THE NET" or "DROPPED"
			end
			awardPoint(winner, reason)
		else
			awardPoint(3 - ball.lastTeam, "OUT")
		end
		remote:FireAllClients("fx", "land", landP, { inside = inside })
	end
	if ball.bounces < 2 and math.abs(v.Y) > 6 then
		ball.bounces += 1
		launch(landP, Vector3.new(v.X * 0.45, math.abs(v.Y) * 0.4, v.Z * 0.45), t, ball.netDone, true)
	else
		ball.mode = "rest"
		ball.restPos = landP
		sendBall()
	end
end

-- Moves the ball's story forward to time t, handling the net and the floor in order
local function stepBall(t)
	for _ = 1, 6 do
		if ball.mode ~= "fly" then
			return
		end
		local tl, tn = landTime(), netTime()
		if tn < tl and tn <= t then
			onNet(tn)
		elseif tl <= t then
			onLand(tl)
		else
			return
		end
	end
end

local function doServe(slot, aim, power, airborne, rootPos)
	local team = slot.team
	local s = side(team)
	local p = rootPos + Vector3.new(0, airborne and 3.2 or 2.6, -s * 1.2)
	if (p.Z - C.Z) * s < HALF_L + 0.5 then
		p = Vector3.new(p.X, p.Y, C.Z + s * (HALF_L + 0.5)) -- serve from behind the end line
	end
	p = Vector3.new(math.clamp(p.X, C.X - HALF_W, C.X + HALF_W), p.Y, p.Z)
	if power ~= power then
		power = 0.5
	end
	power = math.clamp(power, 0, 1)
	local target = clampToOpp(team, aim, 2)
	if power > 0.9 then
		-- over-hit: it sails long
		local dir = Vector3.new(target.X - p.X, 0, target.Z - p.Z).Unit
		target += dir * (power - 0.9) * 110
	end
	-- the green zone (65-90%) is the most accurate
	if power < 0.65 then
		target += jitter(1.5 + (0.65 - power) * 5)
	else
		target += jitter(0.8 + math.max(power - 0.9, 0) * 10)
	end
	local tau = 1.7 + ((airborne and 0.8 or 0.95) - 1.7) * power
	local ace = boosted(slot, "ACE SERVE")
	if ace then
		spendBoost(slot)
		target = clampToOpp(team, aim, 0)
		tau = math.max(tau - 0.25, 0.7)
		power = math.max(power, 0.5)
	end
	local v
	if power < 0.15 then
		-- under-hit: straight into the net
		v = solve(p, Vector3.new(target.X, GY + NET_H - 2.5, C.Z), 1.1)
	else
		v = solveOver(p, target, tau, 2.2)
	end
	ball.live = true
	ball.lastTeam, ball.lastSlot, ball.lastKind, ball.touches = team, slot, "serve", 0
	ball.holder = nil
	phase = "rally"
	launch(p, v, now())
	ball.power = ace
	act(slot, airborne and "jumpserve" or "serve")
	remote:FireAllClients("fx", "hit", p, { kind = "serve", q = 1, user = slot.player and slot.player.UserId or 0, team = team, index = slot.index })
	sendState()
end

---------------------------------------------------------------- match flow

local matchContext = nil -- how the current match was started (quick play, career or online)
local pausedBy = ""

function currentServer()
	local team = teams[servingTeam]
	return team.slots[math.max(team.serveIndex, 1)]
end

function sendState(plr)
	local srv = (phase == "serve") and currentServer() or nil
	-- who is playing, by user id as text (remote tables need text keys)
	local controls = {}
	for person, ctrl in controllers do
		controls[tostring(person.UserId)] = { team = ctrl.team, home = ctrl.home }
	end
	local roster = { {}, {} }
	for t = 1, 2 do
		for _, s in teams[t].slots do
			local p = playerOf(s)
			local st = s.stats or {}
			local index = teams[t].lineup[s.index]
			table.insert(roster[t], {
				index = s.index,
				squad = index,
				name = s.player and string.upper(s.player.DisplayName) or (p and p.last or "PLAYER"),
				ctrl = s.player and s.player.DisplayName or nil,
				captain = teams[t].plan and index == teams[t].plan.captain and p and p.role ~= "L" or nil,
				rot = rotationPos(s),
				front = isFrontRow(s),
				number = p and p.number or s.index,
				role = p and p.role or "OH",
				ovr = p and p.ovr or 70,
				id = s.player and s.player.UserId or 0,
				model = s.model,
				k = st.kills or 0,
				a = st.aces or 0,
				b = st.blocks or 0,
				d = st.digs or 0,
				meter = math.floor(s.meter or 0),
				ability = abilityOf(s),
				boost = (s.boost and s.boost.untilT > now()) and s.boost.kind or nil,
			})
		end
	end
	local data = {
		active = matchActive,
		phase = phase,
		score = { teams[1].score, teams[2].score },
		sets = { teams[1].sets, teams[2].sets },
		serving = servingTeam,
		server = srv and srv.player and srv.player.UserId or 0,
		serverTeam = srv and srv.team or 0,
		serverIndex = srv and srv.index or 0,
		touches = ball.touches,
		touchTeam = ball.lastTeam,
		roster = roster,
		deadline = serveDeadline,
		serveIndex = { teams[1].serveIndex, teams[2].serveIndex },
		teamIds = { teams[1].defId, teams[2].defId },
		lineups = { teams[1].lineup, teams[2].lineup },
		points = pointsToWin,
		setsToWin = setsToWin,
		teamSize = TEAM_SIZE,
		paused = paused,
		pausedAt = pausedAt,
		pausedBy = pausedBy,
		mode = matchContext and matchContext.mode or "quick",
		plans = { teams[1].plan, teams[2].plan },
		subs = { teams[1].subs, teams[2].subs },
		subsMax = Config.SUBS_PER_SET or 6,
		controls = controls,
	}
	if plr then
		remote:FireClient(plr, "state", data)
	else
		remote:FireAllClients("state", data)
	end
end

function setupServe()
	phase = "serve"
	local srv = currentServer()
	ball.live = false
	ball.mode = "hold"
	ball.holder = srv
	ball.lastTeam, ball.lastSlot, ball.lastKind, ball.touches = 0, nil, nil, 0
	ball.id += 1
	ball.restPos = serveSpot(srv) + Vector3.new(0, 3, 0)
	serveAt = now() + rng:NextNumber(1.4, 2.4)
	serveDeadline = now() + Config.SERVE_TIME
	for t = 1, 2 do
		teams[t].brain = {}
		for _, s in teams[t].slots do
			dressBot(s) -- the libero comes on or off as players rotate
		end
	end
	-- an AI server who has already walked to the line isn't teleported
	if not (srv.isAI and srv.root and flatDist(srv.root.Position, serveSpot(srv)) < 4) then
		placeSlot(srv, serveSpot(srv))
	end
	local style = tactic(srv.team, "serve")
	local styleJump = style == "AGGRESSIVE" and 1.6 or style == "SAFE" and 0.5 or 1
	srv.ai.jumpServe = rng:NextNumber() < teamAI(srv.team).jumpServe * styleJump * (0.6 + 0.8 * attr01(srv, "SRV"))
	srv.ai.serveJumped = false
	srv.ai.prepped = false
	sendBall()
	sendState()
end

local matchNo = 0
local function startMatch()
	matchNo += 1
	servingTeam = (matchNo % 2 == 1) and 1 or 2 -- take turns serving first
	for t = 1, 2 do
		teams[t].score, teams[t].sets = 0, 0
		teams[t].serveIndex = (t == servingTeam) and 1 or 0
		for _, s in teams[t].slots do
			s.stats = { kills = 0, aces = 0, blocks = 0, digs = 0 }
			placeSlot(s, homeSpot(s))
		end
	end
	setupServe()
	local format = setsToWin > 1 and ("BEST OF " .. (setsToWin * 2 - 1) .. " SETS") or "ONE SET"
	banner("FIRST TO " .. pointsToWin, format, 0)
end

local function moveOffCourt(plr)
	local char = plr.Character
	if char and char.PrimaryPart then
		local spot = Vector3.new(C.X + HALF_W + 10, GY + 4, C.Z + HALF_L + 12)
		char:PivotTo(CFrame.lookAt(spot, Vector3.new(C.X, spot.Y, C.Z)))
	end
end

-- Ends the match: people go back to the menu, AI bodies are removed, the court goes quiet
function stopMatch()
	local finished = phase == "matchover"
	local winner = teams[1].sets > teams[2].sets and 1 or 2
	local results = {}
	for plr, ctrl in controllers do
		local home = teams[ctrl.team].slots[ctrl.home]
		table.insert(results, { player = plr, team = ctrl.team, stats = home and home.stats or {}, won = ctrl.team == winner })
	end
	local context = matchContext
	matchContext = nil
	paused = false
	matchActive = false
	phase = "idle"
	ball.live = false
	ball.mode = "hidden"
	ball.holder = nil
	for t = 1, 2 do
		for _, s in teams[t].slots do
			local plr = s.player
			if plr then
				if charConnections[plr] then
					charConnections[plr]:Disconnect()
					charConnections[plr] = nil
				end
				-- forget the person's character before clearing, so it isn't destroyed
				s.player, s.model, s.humanoid, s.root, s.align = nil, nil, nil, nil, nil
				s.isAI = true
				moveOffCourt(plr)
			end
			s.override, s.meter, s.boost = nil, 0, nil
			clearBody(s)
		end
	end
	table.clear(controllers)
	table.clear(slotOfPlayer)
	sendBall()
	sendState()
	if finished and context and onMatchFinished then
		task.spawn(onMatchFinished, context, results, winner)
	end
end

-- The pause menu stops everything; on resume the ball and every timer pick up where they were
local function setPaused(on, who)
	if on == paused or not matchActive then
		return
	end
	local t = now()
	if on then
		paused, pausedAt, pausedBy = true, t, who or ""
		for team = 1, 2 do
			for _, s in teams[team].slots do
				if s.isAI and s.humanoid then
					s.humanoid:Move(Vector3.zero)
					s.ai.vel = Vector3.zero
				end
			end
		end
	else
		local gap = t - pausedAt
		paused = false
		ball.t0 += gap
		serveAt += gap
		serveDeadline += gap
		phaseUntil += gap
		for team = 1, 2 do
			teams[team].brain = {}
			if teams[team].call then
				teams[team].call.untilT += gap
			end
			for _, s in teams[team].slots do
				if s.boost then
					s.boost.untilT += gap
				end
			end
		end
		sendBall()
	end
	sendState()
end

local function aiServe(slot, jumped)
	local ai = teamAI(slot.team)
	local serve = attr01(slot, "SRV")
	-- serve strategy: safe serves are softer and rarely missed, aggressive ones the opposite
	local style = tactic(slot.team, "serve")
	local shift = style == "AGGRESSIVE" and 0.06 or style == "SAFE" and -0.09 or 0
	local faults = style == "AGGRESSIVE" and 1.6 or style == "SAFE" and 0.45 or 1
	local margin = ai.margin + 1 + (style == "AGGRESSIVE" and -0.8 or style == "SAFE" and 1 or 0)
	local lo = math.clamp(ai.serveLo + shift + (serve - 0.5) * 0.15, 0.2, 0.88)
	local hi = math.clamp(ai.serveHi + shift + (serve - 0.5) * 0.15, lo + 0.05, 0.93)
	local power = rng:NextNumber(lo, hi)
	if rng:NextNumber() < ai.fault * faults * (1.5 - serve) then
		power = rng:NextNumber() < 0.5 and 0.05 or 0.99
	end
	doServe(slot, smartTarget(slot.team, math.max(margin, 1)), power, jumped == true, slot.root.Position)
end

local function updateMatch(t)
	if phase == "point" and t >= phaseUntil then
		setupServe()
	elseif phase == "setover" and t >= phaseUntil then
		teams[1].score, teams[2].score = 0, 0
		teams[1].subs, teams[2].subs = 0, 0 -- substitutions are counted per set
		setupServe()
	elseif phase == "matchover" and t >= phaseUntil then
		stopMatch()
	elseif phase == "serve" then
		local srv = currentServer()
		if srv.root then
			if srv.isAI then
				if not srv.ai.prepped and t >= serveAt - 0.5 then
					srv.ai.prepped = true
					act(srv, "serveprep")
				end
				if t >= serveAt then
					if (srv.meter or 0) >= 100 and not srv.boost then
						activateAbility(srv)
					end
					if srv.ai.jumpServe and not srv.ai.serveJumped and srv.humanoid then
						-- jump serve: leave the ground, hit it a moment later
						srv.ai.serveJumped = true
						srv.humanoid.Jump = true
						serveAt = t + 0.25
					else
						aiServe(srv, srv.ai.serveJumped)
					end
				end
			elseif t >= serveDeadline then
				doServe(srv, floorPoint(3 - srv.team, 0, HALF_L * 0.5), 0.5, false, srv.root.Position)
			end
		end
	end
end

---------------------------------------------------------------- AI movement
-- AI players steer instead of walking on rails: they speed up and slow down, keep a
-- little space from teammates, react a beat apart, and shuffle facing the ball.

local function steer(slot, order, t, dt, lookAt)
	local hum, hrp, mem = slot.humanoid, slot.root, slot.ai
	local ai = teamAI(slot.team)
	local s = side(slot.team)
	local here = hrp.Position
	local grounded = hum.FloorMaterial ~= Enum.Material.Air

	-- take up a new target after a short personal delay; small corrections are instant
	if order.pos then
		local lz = math.clamp((order.pos.Z - C.Z) * s, 1.4, HALF_L + 8)
		local lx = math.clamp(order.pos.X - C.X, -HALF_W - 8, HALF_W + 8)
		local want = Vector3.new(C.X + lx, GY, C.Z + s * lz)
		if not mem.target or flatDist(want, mem.target) < 1.5 or order.sprint then
			mem.target, mem.switchAt = want, nil
		elseif not mem.switchAt then
			mem.switchAt = t + rng:NextNumber(0.03, order.run and 0.12 or 0.35)
		elseif t >= mem.switchAt then
			mem.target, mem.switchAt = want, nil
		end
	end

	local vel = mem.vel or Vector3.zero
	if (slot.diveUntil or 0) > t then
		vel = vel * (1 - math.min(dt * 2.5, 1)) -- sliding out of a dive
	else
		local maxSpeed = ai.speed * (mem.pace or 1)
		if order.sprint then
			maxSpeed += 6
		elseif order.run then
			maxSpeed += 3
		elseif order.walk then
			maxSpeed = 8.5 * (mem.pace or 1)
		end
		if (mem.recoverUntil or 0) > t then
			maxSpeed *= 0.35 -- getting up after a dive
		end
		local desired = Vector3.zero
		if mem.target and not order.hold then
			local offset = Vector3.new(mem.target.X - here.X, 0, mem.target.Z - here.Z)
			local dist = offset.Magnitude
			if dist > 0.35 then
				desired = offset.Unit * math.min(maxSpeed, 1.5 + dist * 3) -- ease into the spot
			end
		end
		-- keep a little space from teammates
		for _, other in teams[slot.team].slots do
			if other ~= slot and other.root then
				local away = Vector3.new(here.X - other.root.Position.X, 0, here.Z - other.root.Position.Z)
				local d = away.Magnitude
				if d > 0.01 and d < 2.6 then
					desired += away.Unit * (2.6 - d) * 2
				end
			end
		end
		-- accelerate towards it instead of snapping
		local accel = grounded and ((order.sprint or order.run) and 46 or 24) or 6
		local change = desired - vel
		local maxChange = accel * dt
		if change.Magnitude > maxChange then
			change = change.Unit * maxChange
		end
		vel += change
	end
	mem.vel = vel

	local speed = vel.Magnitude
	if speed > 0.3 then
		hum.WalkSpeed = speed
		hum:Move(vel.Unit)
	else
		hum:Move(Vector3.zero)
	end

	-- watch the ball while shuffling; turn into the run when sprinting
	local toBall = Vector3.new(lookAt.X - here.X, 0, lookAt.Z - here.Z)
	local face = toBall.Magnitude > 0.5 and toBall.Unit or Vector3.new(0, 0, -s)
	if speed > 11 then
		local w = math.clamp((speed - 11) / 8, 0, 0.85)
		face = face * (1 - w) + vel.Unit * w
	end
	if grounded or (slot.diveUntil or 0) > t then
		faceTowards(slot, face)
	end
end

---------------------------------------------------------------- AI decisions

local deferredTouches = {}

local function aiTouch(slot, kind, t)
	local ai = teamAI(slot.team)
	local bp = ballPos(t)
	local use = kind
	if kind == "spike" and rng:NextNumber() < 0.15 then
		use = "tip"
	end
	local ok, q = reachCheck(slot, use, slot.root.Position, bp, true, t)
	if not ok and kind == "spike" then
		use = "bump"
		ok, q = reachCheck(slot, use, slot.root.Position, bp, true, t)
	end
	if not ok then
		return
	end
	-- touch quality: the team's level and the player's own rating for that skill
	local skill = attr01(slot, (use == "set") and "SET" or (use == "bump") and "REC" or "ATK")
	local level = ai.quality * 0.55 + skill * 0.45
	q = math.clamp(q * 0.35 + level * 0.65 + rng:NextNumber(-0.12, 0.08), 0.1, 1)
	if use ~= "spike" and rng:NextNumber() < ai.shank * (1.5 - skill) then
		q = 0.08 -- shanked pass
	end
	local aim = nil
	if use == "spike" then
		aim = smartTarget(slot.team, ai.margin)
		if rng:NextNumber() < ai.attackErr * (1.5 - skill) then
			-- attack error: just past a line
			local opp = 3 - slot.team
			if rng:NextNumber() < 0.5 then
				local sx = rng:NextNumber() < 0.5 and -1 or 1
				aim = floorPoint(opp, sx * (HALF_W + rng:NextNumber(1.5, 3)), rng:NextNumber(6, HALF_L - 2))
			else
				aim = floorPoint(opp, rng:NextNumber(-HALF_W + 2, HALF_W - 2), HALF_L + rng:NextNumber(1.5, 3))
			end
		end
	elseif nextTouchNo(slot.team) >= 3 then
		aim = randomOpp(slot.team, ai.margin + 2)
	end
	-- applied after both teams have thought this frame, so neither side reacts a frame early
	table.insert(deferredTouches, { slot = slot, use = use, bp = bp, t = t, aim = aim, q = q, id = ball.id })
end

local function flushTouches()
	for _, d in deferredTouches do
		if ball.id == d.id and ball.live and ball.mode == "fly" then
			touch(d.slot, d.use, d.bp, d.t, d.aim, d.q)
		end
	end
	table.clear(deferredTouches)
end

-- Where a hitter waits to start his run-up: behind his lane
local function approachSpot(slot)
	local s = side(slot.team)
	local lane = LANE[roleOf(slot)] or -1
	return Vector3.new(C.X + s * HALF_W * 0.62 * lane, GY, C.Z + s * 9)
end

-- Decides what each AI on a team does while the ball is in play
local function planRally(team, t, brain)
	local orders = {}
	local tm = teams[team]
	local ai = tm.ai
	local s = side(team)
	local n = nextTouchNo(team)
	local land = ballPos(landTime())
	local mine = (land.Z - C.Z) * s > 0 and n <= 3
	if mine and ball.lastTeam ~= team then
		local out = math.abs(land.X - C.X) > HALF_W + 1.5 or math.abs(land.Z - C.Z) > HALF_L + 1.5
		if out then
			if brain.letGoId ~= ball.id then
				brain.letGoId = ball.id
				brain.letGo = rng:NextNumber() < ai.letGo
			end
			if brain.letGo then
				mine = false
			end
		end
	end

	if mine then
		-- choose the shot and the player once per flight
		if brain.planId ~= ball.id then
			brain.planId = ball.id
			local kind, h = "bump", GY + 3
			if n == 2 then
				kind, h = "set", GY + 6.2
			elseif n == 3 then
				kind, h = "spike", GY + ATTACK_H
			end
			local tc = heightTime(h)
			if kind == "spike" and (not tc or (ballPos(tc).Z - C.Z) * s > 14) then
				kind, h = "bump", GY + 3 -- too low or too deep to attack: free ball
				tc = heightTime(h)
			elseif kind == "set" and not tc then
				kind, h = "bump", GY + 3
				tc = heightTime(h)
			end
			tc = math.max(tc or t, t)
			local cp = ballPos(tc)
			local who, bestD = nil, math.huge
			for _, sl in tm.slots do
				if sl.root and not (TEAM_SIZE > 1 and ball.lastSlot == sl) then
					local d = flatDist(sl.root.Position, cp)
					local role = roleOf(sl)
					if not sl.isAI then
						d -= 3 -- leave it to a nearby person
					end
					if kind == "spike" and TEAM_SIZE == 6 then
						-- the front row attacks; the libero never does
						d += (role == "L" and 20) or (isFrontRow(sl) and -4) or 4
					end
					if kind == "set" and role == "S" then
						d -= 12 -- the setter takes the second ball
					elseif kind == "bump" and n == 1 then
						if role == "S" then
							d += 5 -- keep the setter free to set
						elseif role == "MB" then
							d += 3
						elseif role == "L" then
							d -= 2
						end
					end
					if d < bestD then
						who, bestD = sl, d
					end
				end
			end
			-- an AI in the back row (or the libero) plays it over instead of attacking at the net
			if who and who.isAI and kind == "spike" and TEAM_SIZE == 6 and (not isFrontRow(who) or roleOf(who) == "L") then
				kind = "bump"
				tc = math.max(heightTime(GY + 3) or t, t)
				cp = ballPos(tc)
			end
			brain.kind, brain.tc, brain.cp, brain.who = kind, tc, cp, who
			if who and who.player then
				remote:FireClient(who.player, "cue", (n == 3 and kind == "bump") and "over" or kind, tc, cp)
			end
		end
		local who, kind, tc, cp = brain.who, brain.kind, brain.tc, brain.cp
		if who and who.isAI and (who.meter or 0) >= 100 and not who.boost then
			local role = roleOf(who)
			if (kind == "spike" and (role == "OH" or role == "OPP")) or (kind == "set" and role == "S") or (kind == "bump" and role == "L") then
				activateAbility(who)
			end
		end
		if who and who.isAI and who.root and who.humanoid then
			local stand = Vector3.new(cp.X, GY, cp.Z)
			if kind == "spike" then
				-- run-up: wait behind and outside the ball, then attack it and jump
				local lane = (cp.X - C.X) >= 0 and 1 or -1
				local start = Vector3.new(cp.X + lane * 2.5, GY, cp.Z + s * 6)
				local runTime = flatDist(start, cp) / (ai.speed + 6) + 0.3
				if t < tc - runTime then
					orders[who] = { pos = start, run = true }
				else
					orders[who] = { pos = stand + Vector3.new(0, 0, s * 0.8), sprint = true }
				end
				if who.ai.jumpId ~= ball.id and tc - t < 0.32 and flatDist(who.root.Position, cp) < 4.5 then
					who.ai.jumpId = ball.id
					who.humanoid.Jump = true
				end
			else
				orders[who] = { pos = stand, run = true }
				-- dive only for a ball he can't reach by running
				local far = flatDist(who.root.Position, cp)
				local short = far - (ai.speed + 3) * math.max(tc - t, 0)
				if who.ai.diveId ~= ball.id and tc - t < 0.35 and tc - t > 0.05 and short > REACH - 1 and far < REACH + 4.5 then
					who.ai.diveId = ball.id
					who.diveUntil = t + 0.7
					who.ai.recoverUntil = t + 1.5
					local dir = Vector3.new(cp.X - who.root.Position.X, 0, cp.Z - who.root.Position.Z)
					if dir.Magnitude > 0.1 then
						who.ai.vel = dir.Unit * 30
						who.root.AssemblyLinearVelocity = dir.Unit * 30 + Vector3.new(0, 9, 0)
						faceTowards(who, dir)
					end
					act(who, "dive")
				end
			end
			if t >= tc - 0.05 then
				aiTouch(who, kind, t)
			end
		end
		-- teammates get ready for the next touch
		local setter
		for _, sl in tm.slots do
			if sl ~= who and sl.isAI and sl.root and roleOf(sl) == "S" then
				setter = sl
			end
		end
		if n == 1 then
			local spot = setSpot(team)
			local runner = setter
			if not runner then
				local best = math.huge
				for _, sl in tm.slots do
					if sl ~= who and sl.isAI and sl.root and flatDist(sl.root.Position, spot) < best then
						runner, best = sl, flatDist(sl.root.Position, spot)
					end
				end
			end
			if runner then
				orders[runner] = { pos = Vector3.new(spot.X, GY, spot.Z), run = true }
			end
		end
		if n <= 2 then
			-- front-row hitters back off to start their run-ups
			for _, sl in tm.slots do
				if sl ~= who and sl.isAI and sl.root and not orders[sl] and isFrontRow(sl) and LANE[roleOf(sl)] then
					orders[sl] = { pos = approachSpot(sl), run = true }
				end
			end
		end
	elseif ball.lastTeam == 3 - team and ball.touches == 2 and ball.lastKind == "set" then
		-- the other team has set up an attack: block, and shift the defence towards it
		local tco = heightTime(GY + ATTACK_H)
		local cpo = tco and ballPos(tco)
		if cpo and math.abs(cpo.Z - C.Z) < 9 then
			if brain.blockId ~= ball.id then
				brain.blockId = ball.id
				brain.blockGo = rng:NextNumber() < ai.blockTry
			end
			local blockers = {}
			if brain.blockGo then
				local front = {}
				for _, sl in tm.slots do
					if sl.isAI and sl.root and sl.humanoid and isFrontRow(sl) then
						table.insert(front, sl)
					end
				end
				table.sort(front, function(a, b)
					return math.abs(a.root.Position.X - cpo.X) < math.abs(b.root.Position.X - cpo.X)
				end)
				local count = math.min(#front, TEAM_SIZE >= 6 and 2 or 1)
				for i = 1, count do
					local blk = front[i]
					blockers[blk] = true
					if (blk.meter or 0) >= 100 and not blk.boost and roleOf(blk) == "MB" then
						activateAbility(blk)
					end
					local bx = cpo.X + (count == 2 and (i == 1 and -1.6 or 1.6) or 0)
					orders[blk] = { pos = Vector3.new(bx, GY, C.Z + s * 1.6), run = true }
					if blk.ai.jumpId ~= ball.id and tco - t < 0.24 and math.abs(blk.root.Position.X - bx) < 3.5 then
						blk.ai.jumpId = ball.id
						blk.humanoid.Jump = true
					end
				end
			end
			local shift = (cpo.X - C.X) * 0.25
			for _, sl in tm.slots do
				if sl.isAI and not blockers[sl] then
					orders[sl] = { pos = homeSpot(sl) + Vector3.new(shift, 0, 0) }
				end
			end
		end
	end
	return orders
end

local function aiTeam(team, t, dt)
	local tm = teams[team]
	local brain = tm.brain
	if not brain then
		brain = {}
		tm.brain = brain
	end
	local lookAt = ball.restPos
	if ball.mode == "fly" then
		lookAt = ballPos(t)
	elseif ball.mode == "hold" and ball.holder and ball.holder.root then
		lookAt = ball.holder.root.Position
	end

	local orders = {}
	local serving = servingTeam == team
	if phase == "serve" then
		local srv = currentServer()
		for _, sl in tm.slots do
			if sl == srv then
				orders[sl] = { hold = true }
			else
				orders[sl] = { pos = homeSpot(sl, serving and "serving" or "receive"), walk = true }
			end
		end
	elseif phase == "rally" and ball.mode == "fly" and ball.live then
		if brain.seenId ~= ball.id then
			brain.seenId, brain.seenAt, brain.lag = ball.id, t, rng:NextNumber(0, 0.08)
		end
		if t - brain.seenAt < tm.ai.react + brain.lag then
			orders = brain.orders or orders -- still reacting: carry on as before
		else
			orders = planRally(team, t, brain)
		end
	else
		-- between points: walk back; the next server heads for the end line
		local nextServer = (phase == "point" and serving) and currentServer() or nil
		for _, sl in tm.slots do
			if sl == nextServer then
				orders[sl] = { pos = serveSpot(sl), run = true }
			else
				orders[sl] = { pos = homeSpot(sl, serving and "serving" or "receive"), walk = true }
			end
		end
	end
	brain.orders = orders
	for _, sl in tm.slots do
		if sl.isAI and sl.humanoid and sl.root then
			steer(sl, orders[sl] or { pos = homeSpot(sl) }, t, dt, lookAt)
			animateBot(sl)
		end
	end
end

---------------------------------------------------------------- starting and joining from the menu

-- spec: { mode, home, away, plan, points, sets, players = { { player, team, slot, override } } }
local function beginMatch(spec)
	for t = 1, 2 do
		for _, sl in teams[t].slots do
			sl.override, sl.meter, sl.boost = nil, 0, nil
		end
	end
	configureTeams(spec.home, spec.away, spec.plan, spec.awayPlan)
	pointsToWin = spec.points or Config.POINTS_TO_WIN
	setsToWin = spec.sets or Config.SETS_TO_WIN
	matchContext = spec
	matchActive = true
	phase = "setup"
	for _, entry in spec.players do
		local slot = addPlayer(entry.player, entry.team, entry.slot)
		if slot then
			slot.override = entry.override
		end
	end

	-- AI bodies for everyone else, built together
	local building = 0
	for t = 1, 2 do
		for _, sl in teams[t].slots do
			if sl.isAI then
				clearBody(sl)
				building += 1
				task.spawn(function()
					makeBot(sl)
					building -= 1
				end)
			end
		end
	end
	sendState()
	local waited = 0
	while building > 0 and waited < 12 do
		waited += task.wait(0.1)
	end
	if not matchActive then
		return
	end
	startMatch()
end

local function quickPlay(plr, data)
	local count = #Teams.list
	local home = math.clamp(math.floor(tonumber(data.home) or 1), 1, count)
	local away = math.clamp(math.floor(tonumber(data.away) or 2), 1, count)
	if away == home then
		away = home % count + 1
	end
	local points, sets = tonumber(data.points), tonumber(data.sets)
	beginMatch({
		mode = "quick",
		home = home,
		away = away,
		plan = type(data.plan) == "table" and data.plan or { lineup = data.lineup },
		points = (points == 15 or points == 21 or points == 25) and points or nil,
		sets = (sets == 1 or sets == 2 or sets == 3) and sets or nil,
		players = { {
			player = plr,
			team = 1,
			slot = math.clamp(math.floor(tonumber(data.slot) or 2), 1, TEAM_SIZE),
		} },
	})
end

-- Substitution: a bench player comes on for one on the court (his body is rebuilt)
local function substitute(plr, data)
	local ctrl = controllers[plr]
	if not ctrl then
		return
	end
	local team = teams[ctrl.team]
	local outIndex, inIndex = tonumber(data.out), tonumber(data.into)
	local at = outIndex and table.find(team.lineup, outIndex)
	local squad = Teams.squad(team.defId)
	if not at or not inIndex or not squad[inIndex] or table.find(team.lineup, inIndex) or inIndex == team.plan.libero then
		return
	end
	if team.subs >= (Config.SUBS_PER_SET or 6) then
		remote:FireClient(plr, "notice", "No substitutions left this set")
		return
	end
	local target = team.slots[at]
	if not target.isAI then
		remote:FireClient(plr, "notice", "People can't be substituted")
		return
	end
	local lineup = table.clone(team.lineup)
	lineup[at] = inIndex
	local plan = table.clone(team.plan)
	plan.lineup = lineup
	team.plan = Teams.cleanPlan(team.defId, plan)
	applyPlan(ctrl.team)
	team.subs += 1
	target.meter, target.boost = 0, nil
	clearBody(target)
	task.spawn(makeBot, target)
	banner("SUBSTITUTION", "ON " .. squad[inIndex].last .. "   ·   OFF " .. squad[outIndex].last, ctrl.team)
	sendState()
end

---------------------------------------------------------------- input from players

remote.OnServerEvent:Connect(function(plr, action, data)
	if action == "sync" then
		sendState(plr)
		sendBall(plr)
		return
	end
	if type(data) ~= "table" then
		return
	end
	if action == "start" then
		if data.mode == "career" or data.mode == "online" then
			return -- handled with the career and online code
		end
		if not controllers[plr] then
			if matchActive then
				addPlayer(plr, tonumber(data.team) == 2 and 2 or 1, tonumber(data.slot))
			else
				quickPlay(plr, data)
			end
		end
		return
	elseif action == "leave" then
		if controllers[plr] then
			removePlayer(plr)
			moveOffCourt(plr)
		end
		return
	end

	local ctrl = controllers[plr]
	if not matchActive or not ctrl then
		return
	end
	-- things you can do from the pause menu
	if action == "pause" then
		setPaused(data.on == true, plr.DisplayName)
		return
	elseif action == "sub" then
		substitute(plr, data)
		return
	elseif action == "plan" then
		-- tactics and roles during the match (the lineup changes only by substitution)
		local team = teams[ctrl.team]
		local plan = table.clone(team.plan)
		if type(data.tactics) == "table" then
			plan.tactics = data.tactics
		end
		for _, r in Teams.ROLE_SLOTS do
			if data[r.key] ~= nil then
				plan[r.key] = data[r.key]
			end
		end
		team.plan = Teams.cleanPlan(team.defId, plan)
		applyPlan(ctrl.team)
		sendState()
		return
	end
	local slot = slotOfPlayer[plr]
	if not slot or not slot.root or not slot.humanoid then
		return
	elseif paused then
		return -- nothing moves while the match is paused
	end
	local t = now()
	local rootPos = slot.root.Position
	if typeof(data.root) == "Vector3" and (data.root - rootPos).Magnitude < 14 then
		rootPos = data.root -- what the player saw, within reason
	end
	local aim = typeof(data.aim) == "Vector3" and data.aim or nil
	local air = data.air == true and rootPos.Y > standHeight(slot) + 0.3

	if action == "serve" then
		if phase == "serve" and currentServer() == slot and ball.mode == "hold" then
			local fallback = floorPoint(3 - slot.team, 0, HALF_L * 0.5)
			doServe(slot, aim or fallback, tonumber(data.power) or 0.5, air, rootPos)
		end
	elseif action == "prep" then
		if phase == "serve" and currentServer() == slot and t - (slot.lastPrep or 0) > 1 then
			slot.lastPrep = t
			act(slot, "serveprep")
		end
	elseif action == "hit" then
		if phase ~= "rally" or not ball.live or ball.mode ~= "fly" then
			return
		end
		if t - (slot.lastTouch or 0) < 0.45 then
			return
		end
		local kind = data.kind
		if kind ~= "bump" and kind ~= "set" and kind ~= "spike" and kind ~= "tip" then
			return
		end
		if kind == "spike" and not air then
			kind = "bump"
		elseif kind == "tip" and not air then
			kind = "set"
		end
		-- judge the touch at the moment the player clicked (up to 0.3 s ago)
		local ht = t
		if data.id == ball.id and type(data.t) == "number" and t - data.t >= 0 and t - data.t < 0.3 and data.t >= ball.t0 then
			ht = data.t
		end
		local bp = ballPos(ht)
		local ok, q = reachCheck(slot, kind, rootPos, bp, air, ht)
		if not ok and (kind == "spike" or kind == "tip") then
			kind = "set"
			ok, q = reachCheck(slot, kind, rootPos, bp, air, ht)
		end
		if not ok then
			remote:FireClient(plr, "miss")
			return
		end
		touch(slot, kind, bp, ht, aim, q)
	elseif action == "dive" then
		if t - (slot.lastDive or 0) > 1 then
			slot.lastDive = t
			slot.diveUntil = t + 0.7
			act(slot, "dive")
		end
	elseif action == "ability" then
		activateAbility(slot)
	elseif action == "call" then
		-- calling for a quick set: the next set comes to you, fast and low
		teams[slot.team].call = { slot = slot, untilT = t + 4 }
		remote:FireClient(plr, "called")
	end
end)

---------------------------------------------------------------- start

-- nobody plays until they start a match from the menu
Players.PlayerRemoving:Connect(removePlayer)

-- controls, menus and HUD for everyone
local function giveClient(plr)
	local holder = Instance.new("ScreenGui")
	holder.Name = "ArenaVolleyballLoader"
	holder.ResetOnSpawn = false
	clientTemplate:Clone().Parent = holder
	holder.Parent = plr:WaitForChild("PlayerGui")
end
clientTemplate:Clone().Parent = StarterPlayer:WaitForChild("StarterPlayerScripts")
for _, plr in Players:GetPlayers() do
	task.spawn(giveClient, plr)
end

-- shift lock for the "behind player" camera
pcall(function()
	StarterPlayer.EnableMouseLockOption = true
end)
local function allowShiftLock(plr)
	pcall(function()
		plr.DevEnableMouseLock = true
	end)
end

-- The animation pack (Config.ANIMATION_PACK): read the bundle's outfit for its animation
-- assets, build one body with them, and take the animation IDs Roblox puts in it
local PACK_FIELDS = { "IdleAnimation", "WalkAnimation", "RunAnimation", "JumpAnimation", "FallAnimation", "ClimbAnimation", "SwimAnimation" }
local packDescription = nil -- the pack's animation assets, put on people's characters too

local function applyPackTo(char)
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not packDescription or not hum then
		return
	end
	pcall(function()
		local desc = hum:GetAppliedDescription()
		for _, field in PACK_FIELDS do
			if packDescription[field] ~= 0 then
				desc[field] = packDescription[field]
			end
		end
		hum:ApplyDescription(desc)
	end)
end

task.spawn(function()
	local bundleId = tonumber(Config.ANIMATION_PACK) or 0
	if bundleId <= 0 then
		return
	end
	local AssetService = game:GetService("AssetService")
	local ok, details = pcall(AssetService.GetBundleDetailsAsync, AssetService, bundleId)
	if not ok or type(details) ~= "table" then
		warn("[Arena Volleyball] Couldn't read the animation pack: " .. tostring(details))
		return
	end
	local desc = nil
	for _, item in details.Items or {} do
		if item.Type == "UserOutfit" then
			local got, outfit = pcall(Players.GetHumanoidDescriptionFromOutfitId, Players, item.Id)
			if got and outfit then
				desc = outfit
				break
			end
		end
	end
	if not desc then
		-- no outfit in the bundle: match its animations by name
		desc = Instance.new("HumanoidDescription")
		local words = { idle = "IdleAnimation", walk = "WalkAnimation", run = "RunAnimation", jump = "JumpAnimation", fall = "FallAnimation", climb = "ClimbAnimation", swim = "SwimAnimation" }
		for _, item in details.Items or {} do
			if item.Type == "Asset" then
				for word, field in words do
					if string.find(string.lower(item.Name or ""), word) then
						desc[field] = item.Id
					end
				end
			end
		end
	end
	local probe = Instance.new("HumanoidDescription")
	for _, field in PACK_FIELDS do
		probe[field] = desc[field]
	end
	local built, model = pcall(Players.CreateHumanoidModelFromDescription, Players, probe, Enum.HumanoidRigType.R15)
	local animate = built and model and model:FindFirstChild("Animate")
	if not animate then
		warn("[Arena Volleyball] Couldn't load the animation pack's animations")
		return
	end
	local found = 0
	for _, name in { "idle", "walk", "run", "jump", "fall" } do
		local holder = animate:FindFirstChild(name)
		local anim = holder and holder:FindFirstChildWhichIsA("Animation")
		if anim and anim.AnimationId ~= "" then
			PACK[name] = anim.AnimationId
			found += 1
		end
	end
	model:Destroy()
	packDescription = probe
	shared:SetAttribute("PackIdle", PACK.idle)
	print("[Arena Volleyball] Animation pack loaded (" .. found .. " animations)")
	for _, plr in Players:GetPlayers() do
		applyPackTo(plr.Character)
	end
end)

-- people's own characters move with the pack too
local function watchPlayer(plr)
	allowShiftLock(plr)
	plr.CharacterAppearanceLoaded:Connect(applyPackTo)
	if plr.Character then
		task.spawn(applyPackTo, plr.Character)
	end
end
Players.PlayerAdded:Connect(watchPlayer)
for _, plr in Players:GetPlayers() do
	watchPlayer(plr)
end

-- a plain body the menus dress in team kits
task.spawn(function()
	local desc = Instance.new("HumanoidDescription")
	desc.HeadColor, desc.LeftArmColor, desc.RightArmColor = SKIN[3], SKIN[3], SKIN[3]
	local ok, model = pcall(Players.CreateHumanoidModelFromDescription, Players, desc, Enum.HumanoidRigType.R15)
	if ok and model then
		model.Name = "MenuModel"
		local animate = model:FindFirstChild("Animate")
		if animate then
			animate:Destroy()
		end
		model.Parent = shared
	end
end)

ball.mode = "hidden"
local lastError = 0
RunService.Heartbeat:Connect(function(dt)
	if not matchActive or paused then
		return
	end
	local ok, err = pcall(function()
		local t = now()
		stepBall(t)
		updateMatch(t)
		-- take turns going first, and apply AI touches once both teams have decided
		local first = (math.floor(t * 60) % 2) + 1
		aiTeam(first, t, dt)
		aiTeam(3 - first, t, dt)
		flushTouches()
	end)
	if not ok and os.clock() - lastError > 3 then
		lastError = os.clock()
		warn("[Arena Volleyball] " .. tostring(err))
	end
end)

print("[Arena Volleyball] Ready. Start a match from the menu.")

---------------------------------------------------------------- saved progress, career mode and online seasons

local DataStoreService = game:GetService("DataStoreService")

local store = nil
pcall(function()
	store = DataStoreService:GetDataStore("ArenaVolleyball_v1")
end)
local saving = store ~= nil -- turns false if saves fail (Studio without API access)
local profiles = {}

local function storeFailed(err)
	if saving then
		saving = false
		warn("[Arena Volleyball] Progress can't be saved here (" .. tostring(err) .. "). In Studio, turn on Game Settings > Security > Enable Studio Access to API Services.")
	end
end

local function sendProfile(plr)
	if profiles[plr] then
		remote:FireClient(plr, "profile", profiles[plr], saving)
	end
end

local function saveProfile(plr)
	local data = profiles[plr]
	if not data or not store or not saving then
		return
	end
	local ok, err = pcall(store.SetAsync, store, "player_" .. plr.UserId, data)
	if not ok then
		storeFailed(err)
	end
end

local function loadProfile(plr)
	local data = nil
	if store and saving then
		local ok, result = pcall(store.GetAsync, store, "player_" .. plr.UserId)
		if ok then
			data = result
		else
			storeFailed(result)
		end
	end
	if type(data) ~= "table" then
		data = {}
	end
	data.version = 1
	data.online = data.online or { division = 10, points = 0, wins = 0, losses = 0 }
	if not plr.Parent then
		return
	end
	profiles[plr] = data
	sendProfile(plr)
end

---------------------------------------------------------------- the league

local ROUNDS = math.clamp(math.floor(Config.SEASON_ROUNDS or 11), 1, #Teams.list - 1)

-- Round-robin pairings for a round (circle method)
local function pairings(round)
	local count = #Teams.list
	local order = { 1 }
	for k = 1, count - 1 do
		order[k + 1] = 2 + ((k - 1 + round - 1) % (count - 1))
	end
	local list = {}
	for i = 1, count // 2 do
		table.insert(list, { order[i], order[count + 1 - i] })
	end
	return list
end

local function opponentFor(club, round)
	for _, pair in pairings(round) do
		if pair[1] == club then
			return pair[2]
		elseif pair[2] == club then
			return pair[1]
		end
	end
	return club % #Teams.list + 1
end

local function freshTable()
	local t = {}
	for i = 1, #Teams.list do
		t[i] = { p = 0, w = 0, l = 0, pts = 0, sf = 0, sa = 0 }
	end
	return t
end

local function record(tableRows, home, away, homeScore, awayScore)
	local h, a = tableRows[home], tableRows[away]
	h.p += 1
	a.p += 1
	h.sf += homeScore
	h.sa += awayScore
	a.sf += awayScore
	a.sa += homeScore
	if homeScore > awayScore then
		h.w += 1
		a.l += 1
		h.pts += 3
	else
		a.w += 1
		h.l += 1
		a.pts += 3
	end
end

-- A match between two AI clubs: the better side usually wins
local function simulate(home, away)
	local diff = Teams.ratings(home).OVR - Teams.ratings(away).OVR
	local homeWins = rng:NextNumber() < 1 / (1 + math.exp(-diff / 4))
	local loser = rng:NextInteger(12, 23)
	if homeWins then
		return 25, loser
	end
	return loser, 25
end

local function standings(tableRows)
	local order = {}
	for i = 1, #tableRows do
		order[i] = i
	end
	table.sort(order, function(a, b)
		local x, y = tableRows[a], tableRows[b]
		if x.pts ~= y.pts then
			return x.pts > y.pts
		end
		return (x.sf - x.sa) > (y.sf - y.sa)
	end)
	return order
end

---------------------------------------------------------------- career

local function careerOverall(career)
	return Teams.overall(career.role, career.attrs)
end

local function createCareer(plr, data)
	local profile = profiles[plr]
	if not profile then
		return
	end
	local club = math.clamp(math.floor(tonumber(data.club) or 1), 1, #Teams.list)
	local role = table.find(Teams.ROLE_ORDER, data.role) and data.role or "OH"
	local number = math.clamp(math.floor(tonumber(data.number) or 7), 1, 99)
	local attrs = {}
	for _, attr in Teams.ATTRS do
		attrs[attr] = math.clamp(60 + Teams.TEMPLATE[role][attr], 40, 95)
	end
	profile.career = {
		club = club,
		role = role,
		number = number,
		attrs = attrs,
		xp = 0,
		level = 1,
		points = 3,
		season = 1,
		round = 1,
		trophies = 0,
		table = freshTable(),
		stats = { matches = 0, wins = 0, kills = 0, aces = 0, blocks = 0, digs = 0 },
	}
	profile.career.ovr = careerOverall(profile.career)
	sendProfile(plr)
	task.spawn(saveProfile, plr)
end

local function trainCareer(plr, attr)
	local career = profiles[plr] and profiles[plr].career
	if not career or career.points <= 0 or not table.find(Teams.ATTRS, attr) or career.attrs[attr] >= 99 then
		return
	end
	career.attrs[attr] += 1
	career.points -= 1
	career.ovr = careerOverall(career)
	sendProfile(plr)
end

local function startCareerMatch(plr)
	local career = profiles[plr] and profiles[plr].career
	if not career then
		return
	end
	if matchActive then
		remote:FireClient(plr, "notice", "A match is already on in this server. Join it from Quick Play, or wait for it to finish.")
		return
	end
	local lineup = Teams.defaultLineup()
	local squad = Teams.squad(career.club)
	local slot = 2
	for i, index in lineup do
		if squad[index].role == career.role then
			slot = i
			break
		end
	end
	if career.role == "L" then
		slot = 3 -- the libero takes a middle blocker's place
	end
	local attrs = table.clone(career.attrs)
	beginMatch({
		mode = "career",
		home = career.club,
		away = opponentFor(career.club, career.round),
		plan = { lineup = lineup, tactics = career.tactics },
		players = {
			{
				player = plr,
				team = 1,
				slot = slot,
				override = { first = "", last = string.upper(plr.DisplayName), number = career.number, role = career.role, attrs = attrs, ovr = career.ovr, hand = "Right" },
			},
		},
	})
end

local function finishCareerMatch(plr, result, context)
	local profile = profiles[plr]
	local career = profile and profile.career
	if not career then
		return
	end
	local st = result.stats
	local opponent = context.away
	local myScore, theirScore = teams[1].score, teams[2].score
	local xp = 40 + (result.won and 30 or 0) + (st.kills or 0) * 10 + (st.aces or 0) * 15 + (st.blocks or 0) * 12 + (st.digs or 0) * 5
	career.xp += xp
	local levels = 0
	while career.xp >= 100 * career.level do
		career.xp -= 100 * career.level
		career.level += 1
		career.points += 3
		levels += 1
	end
	career.stats.matches += 1
	career.stats.wins += result.won and 1 or 0
	for key, field in { kills = "kills", aces = "aces", blocks = "blocks", digs = "digs" } do
		career.stats[key] += st[field] or 0
	end
	-- this round: our match plus every other one
	record(career.table, career.club, opponent, myScore, theirScore)
	for _, pair in pairings(career.round) do
		if pair[1] ~= career.club and pair[2] ~= career.club then
			local h, a = simulate(pair[1], pair[2])
			record(career.table, pair[1], pair[2], h, a)
		end
	end
	local summary = {
		opponent = opponent,
		won = result.won,
		score = myScore .. " - " .. theirScore,
		xp = xp,
		levels = levels,
		round = career.round,
	}
	career.round += 1
	if career.round > ROUNDS then
		local order = standings(career.table)
		summary.champion = order[1]
		summary.position = table.find(order, career.club)
		if order[1] == career.club then
			career.trophies += 1
		end
		career.season += 1
		career.round = 1
		career.table = freshTable()
	end
	career.last = summary
	remote:FireClient(plr, "career_result", summary)
	sendProfile(plr)
	task.spawn(saveProfile, plr)
end

---------------------------------------------------------------- online seasons (players in this server)

local queue = {}
local DIVISION_TARGET = 9 -- points needed to go up a division

local function queueStatus()
	for _, entry in queue do
		remote:FireClient(entry.player, "online_queue", true, #queue)
	end
end

local function leaveQueue(plr)
	for i, entry in queue do
		if entry.player == plr then
			table.remove(queue, i)
			remote:FireClient(plr, "online_queue", false, #queue)
			break
		end
	end
	queueStatus()
end

local function tryOnlineMatch()
	if matchActive or #queue < 2 then
		queueStatus()
		return
	end
	local a = table.remove(queue, 1)
	local b = table.remove(queue, 1)
	local away = b.club
	if away == a.club then
		away = a.club % #Teams.list + 1
	end
	for _, entry in { a, b } do
		remote:FireClient(entry.player, "online_queue", false, 0)
	end
	beginMatch({
		mode = "online",
		home = a.club,
		away = away,
		plan = a.plan,
		awayPlan = away == b.club and b.plan or nil,
		players = {
			{ player = a.player, team = 1, slot = 2 },
			{ player = b.player, team = 2, slot = 2 },
		},
	})
end

local function finishOnlineMatch(plr, result)
	local online = profiles[plr] and profiles[plr].online
	if not online then
		return
	end
	if result.won then
		online.wins += 1
		online.points += 3
		if online.points >= DIVISION_TARGET and online.division > 1 then
			online.division -= 1
			online.points = 0
		end
	else
		online.losses += 1
		if online.points == 0 and online.division < 10 then
			online.division += 1
			online.points = DIVISION_TARGET // 2
		else
			online.points = math.max(0, online.points - 1)
		end
	end
	remote:FireClient(plr, "online_result", result.won, online.division, online.points)
	sendProfile(plr)
	task.spawn(saveProfile, plr)
end

function onMatchFinished(context, results, _winner)
	for _, result in results do
		if result.player.Parent then
			if context.mode == "career" then
				finishCareerMatch(result.player, result, context)
			elseif context.mode == "online" then
				finishOnlineMatch(result.player, result)
			end
		end
	end
	task.delay(2, tryOnlineMatch)
end

---------------------------------------------------------------- requests from the menus

remote.OnServerEvent:Connect(function(plr, action, data)
	if type(data) ~= "table" then
		data = {}
	end
	if action == "profile" then
		sendProfile(plr)
	elseif action == "career_create" then
		createCareer(plr, data)
	elseif action == "career_train" then
		trainCareer(plr, data.attr)
	elseif action == "career_tactics" then
		-- the team tactics you play with in your career
		local career = profiles[plr] and profiles[plr].career
		if career and type(data.tactics) == "table" then
			career.tactics = Teams.cleanPlan(career.club, { tactics = data.tactics }).tactics
			sendProfile(plr)
		end
	elseif action == "career_save" then
		task.spawn(saveProfile, plr)
	elseif action == "career_retire" then
		if profiles[plr] then
			profiles[plr].career = nil
			sendProfile(plr)
			task.spawn(saveProfile, plr)
		end
	elseif action == "start" and data.mode == "career" then
		if not controllers[plr] then
			startCareerMatch(plr)
		end
	elseif action == "start" and data.mode == "online" then
		if not controllers[plr] then
			leaveQueue(plr)
			table.insert(queue, { player = plr, club = math.clamp(math.floor(tonumber(data.club) or 1), 1, #Teams.list), plan = type(data.plan) == "table" and data.plan or nil })
			tryOnlineMatch()
		end
	elseif action == "online_cancel" then
		leaveQueue(plr)
	end
end)

Players.PlayerAdded:Connect(loadProfile)
for _, plr in Players:GetPlayers() do
	task.spawn(loadProfile, plr)
end
Players.PlayerRemoving:Connect(function(plr)
	leaveQueue(plr)
	saveProfile(plr)
	profiles[plr] = nil
end)
game:BindToClose(function()
	for plr in profiles do
		saveProfile(plr)
	end
end)
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX2">
			<Properties>
				<string name="Name">Config</string>
				<ProtectedString name="Source"><![CDATA[-- ARENA VOLLEYBALL settings. Change a value, then press Play.
-- Sizes use Roblox's scale of 1 stud = 0.28 m, so the court matches a real one.
return {
	TEAM_SIZE = 6, -- players per side (1 to 6). Empty spots are played by AI. 6 uses real rotations.
	POINTS_TO_WIN = 25, -- points needed to win a set
	WIN_BY = 2,
	SETS_TO_WIN = 1, -- 1 = one set, 2 = best of three, 3 = best of five

	-- The court is built here, on the ground below this point.
	COURT_CENTER = Vector3.new(0, 0, 110),

	-- Real dimensions in studs
	COURT_LENGTH = 64, -- 18 m
	COURT_WIDTH = 32, -- 9 m
	NET_HEIGHT = 10, -- taller than a real net (8.7) so it looks right next to Roblox players

	GRAVITY = 35, -- 9.81 m/s²
	BALL_RADIUS = 0.42, -- a real ball is 0.38; a touch bigger so it's easy to follow
	REACH = 6.5, -- how far from your body you can play the ball
	SERVE_TIME = 8, -- seconds to serve (8 s, like the real rule) before one is made for you

	-- Your own animations: paste an animation ID for any move (0 uses the built-in pose).
	-- Upload them to the same account or group that owns the game, or Roblox won't play them.
	ANIMATIONS = {
		serve = 0,
		jumpserve = 0,
		bump = 0,
		set = 0,
		spike = 0,
		tip = 0,
		block = 0,
		dive = 0,
	},

	-- Sound IDs (0 = silent): ball contact, spikes, the whistle after a point, crowd cheer
	SOUNDS = { hit = 0, spike = 0, whistle = 0, crowd = 0 },

	-- Every player (AI and people) walks, runs and idles with this animation bundle (0 = Roblox's own)
	ANIMATION_PACK = 10739370185157, -- Garry's Animation Pack

	SUBS_PER_SET = 6, -- substitutions each team may make in a set (the libero doesn't count)
	ABILITY_CHARGE = 1, -- how fast ability meters fill (2 = twice as fast)
	SEASON_ROUNDS = 11, -- career league: every club plays each other once
}
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX3">
			<Properties>
				<string name="Name">Teams</string>
				<ProtectedString name="Source"><![CDATA[-- ARENA VOLLEYBALL teams: the twelve clubs of the Arena League and their squads.
-- Squads are generated from fixed seeds, so the server and every player see the
-- same names, numbers and ratings.
local Teams = {}

Teams.LEAGUE = "ARENA LEAGUE"
Teams.STARTERS = 6
Teams.SQUAD_SIZE = 12 -- six starters, the libero and five on the bench

Teams.ROLES = {
	S = "SETTER",
	OH = "OUTSIDE HITTER",
	MB = "MIDDLE BLOCKER",
	OPP = "OPPOSITE",
	L = "LIBERO",
}
Teams.ATTRS = { "SRV", "ATK", "BLK", "REC", "SET", "PHY" }
Teams.ATTR_NAMES = { SRV = "Serve", ATK = "Attack", BLK = "Block", REC = "Reception", SET = "Setting", PHY = "Athleticism" }

Teams.list = {
	{ name = "ARENA CITY", short = "ACV", primary = Color3.fromRGB(60, 130, 255), secondary = Color3.fromRGB(16, 26, 64), rating = 86 },
	{ name = "NORTHPORT TITANS", short = "NPT", primary = Color3.fromRGB(220, 50, 60), secondary = Color3.fromRGB(245, 245, 245), rating = 84 },
	{ name = "LAKESIDE RAVENS", short = "LKR", primary = Color3.fromRGB(125, 75, 205), secondary = Color3.fromRGB(22, 20, 32), rating = 82 },
	{ name = "REDHILL ROCKETS", short = "RHR", primary = Color3.fromRGB(255, 120, 30), secondary = Color3.fromRGB(28, 28, 32), rating = 80 },
	{ name = "COASTAL WAVES", short = "CWV", primary = Color3.fromRGB(20, 180, 170), secondary = Color3.fromRGB(240, 250, 250), rating = 78 },
	{ name = "IRON VALLEY", short = "IRV", primary = Color3.fromRGB(112, 118, 128), secondary = Color3.fromRGB(250, 205, 40), rating = 76 },
	{ name = "SUMMIT HAWKS", short = "SMH", primary = Color3.fromRGB(40, 160, 80), secondary = Color3.fromRGB(240, 240, 240), rating = 74 },
	{ name = "HARBOR KINGS", short = "HBK", primary = Color3.fromRGB(230, 180, 40), secondary = Color3.fromRGB(20, 30, 70), rating = 72 },
	{ name = "METRO STRIKERS", short = "MTS", primary = Color3.fromRGB(215, 40, 150), secondary = Color3.fromRGB(22, 22, 26), rating = 70 },
	{ name = "SUNSET SPIKERS", short = "SSP", primary = Color3.fromRGB(255, 100, 90), secondary = Color3.fromRGB(70, 30, 110), rating = 68 },
	{ name = "GLACIER BEARS", short = "GLB", primary = Color3.fromRGB(150, 210, 255), secondary = Color3.fromRGB(250, 250, 255), rating = 66 },
	{ name = "VOLT UNITED", short = "VLT", primary = Color3.fromRGB(250, 225, 30), secondary = Color3.fromRGB(22, 22, 22), rating = 64 },
}

local FIRST = {
	"Lucas", "Mateo", "Kai", "Leon", "Noah", "Hugo", "Ivan", "Marco", "Tomas", "Luca",
	"Elias", "Yuki", "Rafael", "Jonas", "Omar", "Diego", "Felix", "Theo", "Nikola", "Arturo",
	"Sami", "Bruno", "Ezra", "Mikael", "Andre", "Dario", "Kenji", "Viktor", "Pablo", "Emil",
	"Jules", "Tariq", "Aaron", "Milan", "Oscar", "Ruben", "Stefan", "Kofi", "Lars", "Enzo",
}
local LAST = {
	"Silva", "Kato", "Novak", "Reyes", "Okafor", "Lindqvist", "Moreau", "Park", "Rossi", "Haddad",
	"Ivanov", "Costa", "Bauer", "Kowalski", "Tanaka", "Fischer", "Duarte", "Petrov", "Laurent", "Nakamura",
	"Jensen", "Moretti", "Ferreira", "Sato", "Horvat", "Andersen", "Rivera", "Dubois", "Kaya", "Santos",
	"Wagner", "Popescu", "Mendes", "Yilmaz", "Bianchi", "Larsen", "Ortiz", "Mazur", "Hoffmann", "Vargas",
	"Ricci", "Nowak", "Takahashi", "Leclerc", "Sorensen", "Marin", "Kruger", "Abe", "Castillo", "Volkov",
}

-- The starting six in rotation order (position 1 first: a 5-1 system), the libero, then the bench
local SQUAD_ROLES = { "S", "OH", "MB", "OPP", "OH", "MB", "L", "S", "OH", "MB", "OPP", "L" }

-- How each role differs from the club's rating
local TEMPLATE = {
	S = { SRV = -2, ATK = -10, BLK = -6, REC = -2, SET = 10, PHY = 0 },
	OH = { SRV = 2, ATK = 6, BLK = -2, REC = 4, SET = -12, PHY = 2 },
	MB = { SRV = -4, ATK = 3, BLK = 9, REC = -14, SET = -16, PHY = 4 },
	OPP = { SRV = 5, ATK = 9, BLK = 2, REC = -10, SET = -14, PHY = 3 },
	L = { SRV = -18, ATK = -25, BLK = -25, REC = 12, SET = 0, PHY = 2 },
}
-- What counts towards a player's overall, by role
local WEIGHTS = {
	S = { SRV = 1, ATK = 0.5, BLK = 1, REC = 1, SET = 4, PHY = 1 },
	OH = { SRV = 1, ATK = 3, BLK = 1, REC = 2.5, SET = 0.3, PHY = 1.2 },
	MB = { SRV = 0.8, ATK = 2, BLK = 3.5, REC = 0.3, SET = 0.2, PHY = 1.2 },
	OPP = { SRV = 1.5, ATK = 3.5, BLK = 1.5, REC = 0.5, SET = 0.2, PHY = 1.2 },
	L = { SRV = 0.2, ATK = 0, BLK = 0, REC = 4, SET = 1.5, PHY = 1 },
}

Teams.TEMPLATE = TEMPLATE
Teams.ROLE_ORDER = { "S", "OH", "MB", "OPP", "L" }

-- Small exact random generator (same results everywhere)
local function roller(seed)
	local state = seed % 2147483646 + 1
	return function(lo, hi)
		state = (state * 16807) % 2147483647
		return lo + state % (hi - lo + 1)
	end
end

function Teams.overall(role, attrs)
	local total, weight = 0, 0
	for attr, w in WEIGHTS[role] do
		total += attrs[attr] * w
		weight += w
	end
	return math.floor(total / weight + 0.5)
end

local cache = {}
-- Twelve players: { first, last, number, role, attrs, ovr, hand }
function Teams.squad(id)
	if cache[id] then
		return cache[id]
	end
	local team = Teams.list[id]
	local roll = roller(id * 7919 + 13)
	local squad, usedLast, usedNumber = {}, {}, {}
	for i, role in SQUAD_ROLES do
		local last
		repeat
			last = LAST[roll(1, #LAST)]
		until not usedLast[last]
		usedLast[last] = true
		local number
		repeat
			number = roll(1, 20)
		until not usedNumber[number]
		usedNumber[number] = true
		-- role strengths lift a player's overall about 5 above his base
		local base = team.rating + (i <= 6 and -4 or -9)
		local attrs = {}
		for _, attr in Teams.ATTRS do
			attrs[attr] = math.clamp(base + TEMPLATE[role][attr] + roll(-5, 5), 35, 99)
		end
		squad[i] = {
			first = FIRST[roll(1, #FIRST)],
			last = string.upper(last),
			number = number,
			role = role,
			attrs = attrs,
			ovr = Teams.overall(role, attrs),
			hand = roll(1, 100) <= 85 and "Right" or "Left",
		}
	end
	cache[id] = squad
	return squad
end

function Teams.defaultLineup()
	return { 1, 2, 3, 4, 5, 6 }
end

-- Six different squad places from 1 to SQUAD_SIZE?
function Teams.validLineup(lineup)
	if type(lineup) ~= "table" or #lineup ~= 6 then
		return false
	end
	local seen = {}
	for i = 1, 6 do
		local v = lineup[i]
		if type(v) ~= "number" or v ~= math.floor(v) or v < 1 or v > Teams.SQUAD_SIZE or seen[v] then
			return false
		end
		seen[v] = true
	end
	return true
end

-- Average ratings of a lineup: { OVR, SRV, ATK, BLK, REC, SET, PHY }
function Teams.ratings(id, lineup)
	local squad = Teams.squad(id)
	lineup = lineup or Teams.defaultLineup()
	local sums, count, ovr = {}, 0, 0
	for _, attr in Teams.ATTRS do
		sums[attr] = 0
	end
	for _, index in lineup do
		local p = squad[index]
		if p then
			count += 1
			ovr += p.ovr
			for _, attr in Teams.ATTRS do
				sums[attr] += p.attrs[attr]
			end
		end
	end
	count = math.max(count, 1)
	local out = { OVR = math.floor(ovr / count + 0.5) }
	for _, attr in Teams.ATTRS do
		out[attr] = math.floor(sums[attr] / count + 0.5)
	end
	return out
end

-- Stars in halves from an overall: 84+ is five stars, every 3 points less is half a star
function Teams.stars(ovr)
	return math.clamp(math.floor((ovr - 66) / 3) * 0.5 + 2, 1, 5)
end

-- How good a team's AI is, 0 (weakest) to 1 (best), from its overall
function Teams.skill(ovr)
	return math.clamp((ovr - 58) / 30, 0, 1)
end

---------------------------------------------------------------- game plans: tactics and roles

-- Team tactics: the AI (and your AI teammates) play to these
Teams.TACTICS = {
	{ key = "tempo", name = "ATTACK TEMPO", options = { "HIGH", "BALANCED", "FAST" },
		info = { HIGH = "High, safe sets. Accurate, but blockers have time to get there.", BALANCED = "A mix of high and quick sets.", FAST = "Quick, flat sets that beat the block. Harder to set well." } },
	{ key = "focus", name = "SET DISTRIBUTION", options = { "OUTSIDE", "BALANCED", "MIDDLE", "OPPOSITE" },
		info = { OUTSIDE = "Most sets go to the outside hitters.", BALANCED = "The setter spreads the ball around.", MIDDLE = "Lots of quick balls to the middle blockers.", OPPOSITE = "Feed the opposite on the right side." } },
	{ key = "serve", name = "SERVE STRATEGY", options = { "SAFE", "BALANCED", "AGGRESSIVE" },
		info = { SAFE = "Get it in. Few aces, very few errors.", BALANCED = "Steady serves with some risk.", AGGRESSIVE = "Jump serves at the lines. More aces, more errors." } },
	{ key = "block", name = "BLOCKING", options = { "READ", "BALANCED", "COMMIT" },
		info = { READ = "Jump less often, but block better when they do.", BALANCED = "Block most attacks.", COMMIT = "Block everything. Strong hitters can tool the block." } },
	{ key = "defense", name = "DEFENSIVE LINE", options = { "DEEP", "BALANCED", "UP" },
		info = { DEEP = "Back row stays deep for hard spikes. Tips can drop.", BALANCED = "Standard positions.", UP = "Back row plays close to cover tips. Hard spikes get past." } },
}

-- Team roles, like captain and set pieces in football games
Teams.ROLE_SLOTS = {
	{ key = "captain", name = "CAPTAIN", info = "Lifts the whole team a little." },
	{ key = "libero", name = "LIBERO", info = "Comes on for the middle blocker in the back row." },
	{ key = "goto", name = "GO-TO HITTER", info = "Gets the most sets, and even more late in the set." },
	{ key = "quick", name = "QUICK ATTACKER", info = "The middle blocker the setter goes to for quick balls." },
}

-- Every club has its own style, so opponents play differently
function Teams.defaultTactics(id)
	local roll = roller(id * 104729 + 7)
	local out = {}
	for _, t in Teams.TACTICS do
		-- mostly balanced, with a club flavour or two
		out[t.key] = roll(1, 100) <= 55 and "BALANCED" or t.options[roll(1, #t.options)]
	end
	return out
end

local function hasRole(squad, index, roles)
	local p = squad[index]
	return p ~= nil and table.find(roles, p.role) ~= nil
end

-- Which squad players can take a team role
function Teams.eligible(id, plan, key)
	local squad = Teams.squad(id)
	local out = {}
	if key == "libero" then
		for i, p in squad do
			if p.role == "L" and not table.find(plan.lineup, i) then
				table.insert(out, i)
			end
		end
	elseif key == "captain" then
		for _, i in plan.lineup do
			table.insert(out, i)
		end
	elseif key == "goto" then
		for _, i in plan.lineup do
			if hasRole(squad, i, { "OH", "OPP", "MB" }) then
				table.insert(out, i)
			end
		end
	elseif key == "quick" then
		for _, i in plan.lineup do
			if hasRole(squad, i, { "MB" }) then
				table.insert(out, i)
			end
		end
		if #out == 0 then
			for _, i in plan.lineup do
				if hasRole(squad, i, { "OH", "OPP" }) then
					table.insert(out, i)
				end
			end
		end
	end
	return out
end

-- A full, valid game plan from whatever was sent (missing or bad parts get sensible defaults)
function Teams.cleanPlan(id, plan)
	plan = type(plan) == "table" and plan or {}
	local out = { lineup = Teams.validLineup(plan.lineup) and table.clone(plan.lineup) or Teams.defaultLineup(), tactics = {} }
	local default = Teams.defaultTactics(id)
	local tactics = type(plan.tactics) == "table" and plan.tactics or {}
	for _, t in Teams.TACTICS do
		out.tactics[t.key] = table.find(t.options, tactics[t.key]) and tactics[t.key] or default[t.key]
	end
	for _, r in Teams.ROLE_SLOTS do
		local options = Teams.eligible(id, out, r.key)
		local want = plan[r.key]
		if table.find(options, want) then
			out[r.key] = want
		else
			-- defaults: the setter captains, the best hitter is the go-to, the first middle the quick
			local best, bestOvr = options[1], -1
			for _, i in options do
				local p = Teams.squad(id)[i]
				local score = p.ovr + ((r.key == "captain" and p.role == "S") and 20 or 0)
				if score > bestOvr then
					best, bestOvr = i, score
				end
			end
			out[r.key] = best
		end
	end
	return out
end

-- League position by rating (1 = best)
local ranks
function Teams.rank(id)
	if not ranks then
		local order = {}
		for i = 1, #Teams.list do
			order[i] = i
		end
		table.sort(order, function(a, b)
			return Teams.ratings(a).OVR > Teams.ratings(b).OVR
		end)
		ranks = {}
		for position, teamId in order do
			ranks[teamId] = position
		end
	end
	return ranks[id] or #Teams.list
end

return Teams
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="LocalScript" referent="RBX4">
			<Properties>
				<string name="Name">Client</string>
				<ProtectedString name="Source"><![CDATA[-- ARENA VOLLEYBALL (client): menus, HUD, camera, animations and controls.
-- The server copies this script to every player; you don't need to move it.

if _G.ArenaVolleyballClient then
	return
end
_G.ArenaVolleyballClient = true

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local shared = ReplicatedStorage:WaitForChild("ArenaVolleyball")
local remote = shared:WaitForChild("Remote")
local Config = require(shared:WaitForChild("Config"))
local Teams = require(shared:WaitForChild("Teams"))

local C = shared:GetAttribute("Center")
while not C do
	task.wait(0.1)
	C = shared:GetAttribute("Center")
end
local GY = C.Y
local G = Config.GRAVITY
local R = Config.BALL_RADIUS
local REACH = Config.REACH
local FLOOR = GY + R
local HALF_L = Config.COURT_LENGTH / 2
local HALF_W = Config.COURT_WIDTH / 2

local function serverNow()
	return workspace:GetServerTimeNow()
end

-- your choices from the settings screen
-- camera: "broadcast" (TV-style) or "player" (Roblox's camera behind you, with shift lock)
local settings = { camera = "broadcast", aimMarker = true, radar = true, hints = true }

---------------------------------------------------------------- look: colours and fonts

local COL = {
	bg1 = Color3.fromRGB(44, 30, 122),
	bg2 = Color3.fromRGB(18, 16, 64),
	panel = Color3.fromRGB(26, 22, 90),
	panelHi = Color3.fromRGB(48, 40, 140),
	line = Color3.fromRGB(124, 134, 255),
	teal = Color3.fromRGB(94, 242, 224),
	cyan = Color3.fromRGB(176, 238, 255),
	pink = Color3.fromRGB(255, 84, 204),
	coral = Color3.fromRGB(255, 100, 96),
	violet = Color3.fromRGB(150, 98, 255),
	lime = Color3.fromRGB(214, 255, 60),
	text = Color3.fromRGB(242, 244, 255),
	dim = Color3.fromRGB(162, 168, 214),
	ink = Color3.fromRGB(18, 16, 48),
	win = Color3.fromRGB(64, 204, 96),
	loss = Color3.fromRGB(232, 64, 72),
	gold = Color3.fromRGB(255, 212, 80),
}

local function family(name, weight)
	return Font.new("rbxasset://fonts/families/" .. name .. ".json", weight)
end
local FONT = {
	title = family("RobotoCondensed", Enum.FontWeight.Bold),
	head = family("RobotoCondensed", Enum.FontWeight.Medium),
	body = family("RobotoCondensed", Enum.FontWeight.Regular),
	num = family("Oswald", Enum.FontWeight.Medium),
}

---------------------------------------------------------------- UI building blocks

local function make(class, props, parent)
	local o = Instance.new(class)
	for key, value in props do
		o[key] = value
	end
	if parent then
		o.Parent = parent
	end
	return o
end

local function text(props, parent)
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.BorderSizePixel = 0
	l.TextColor3 = COL.text
	l.FontFace = FONT.body
	l.TextSize = 14
	l.Text = ""
	for key, value in props do
		l[key] = value
	end
	l.Parent = parent
	return l
end

local function frame(props, parent)
	local f = Instance.new("Frame")
	f.BorderSizePixel = 0
	f.BackgroundColor3 = COL.panel
	for key, value in props do
		f[key] = value
	end
	f.Parent = parent
	return f
end

local function button(props, parent)
	local b = Instance.new("TextButton")
	b.BackgroundTransparency = 1
	b.BorderSizePixel = 0
	b.AutoButtonColor = false
	b.Text = ""
	for key, value in props do
		b[key] = value
	end
	b.Parent = parent
	return b
end

local function round(o, radius)
	make("UICorner", { CornerRadius = UDim.new(0, radius) }, o)
end

local function outline(o, color, thickness, transparency)
	return make("UIStroke", {
		Color = color or COL.line,
		Thickness = thickness or 1,
		Transparency = transparency or 0.5,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, o)
end

local function gradient(o, c1, c2, rotation, t1, t2)
	return make("UIGradient", {
		Color = ColorSequence.new(c1, c2),
		Rotation = rotation or 0,
		Transparency = NumberSequence.new(t1 or 0, t2 or 0),
	}, o)
end

-- the main call-to-action button: the violet bar from the menus
local function primaryButton(props, parent, label, textSize)
	local b = button(props, parent)
	b.BackgroundTransparency = 0
	b.BackgroundColor3 = Color3.new(1, 1, 1)
	local g = gradient(b, COL.violet, Color3.fromRGB(110, 70, 230), 0)
	local l = text({ Size = UDim2.fromScale(1, 1), Text = label, FontFace = FONT.title, TextSize = textSize or 20, ZIndex = b.ZIndex + 1 }, b)
	b.MouseEnter:Connect(function()
		g.Color = ColorSequence.new(COL.violet:Lerp(Color3.new(1, 1, 1), 0.2), Color3.fromRGB(130, 90, 245))
	end)
	b.MouseLeave:Connect(function()
		g.Color = ColorSequence.new(COL.violet, Color3.fromRGB(110, 70, 230))
	end)
	return b, l
end

-- a quieter button
local function secondaryButton(props, parent, label, textSize)
	local b = button(props, parent)
	b.BackgroundTransparency = 0
	b.BackgroundColor3 = COL.panelHi
	outline(b, COL.line, 1, 0.5)
	local l = text({ Size = UDim2.fromScale(1, 1), Text = label, FontFace = FONT.title, TextSize = textSize or 18, ZIndex = b.ZIndex + 1 }, b)
	b.MouseEnter:Connect(function()
		b.BackgroundColor3 = COL.panelHi:Lerp(Color3.new(1, 1, 1), 0.12)
	end)
	b.MouseLeave:Connect(function()
		b.BackgroundColor3 = COL.panelHi
	end)
	return b, l
end

---------------------------------------------------------------- drag and drop (squad screen and substitutions)
-- Drag.source(button, payload, ghost, onClick) makes a button draggable; Drag.target(gui,
-- payload) marks where it can be dropped; Drag.onDrop(from, to) is called when it is.

local Drag = { targets = setmetatable({}, { __mode = "k" }), active = nil }
Drag.gui = make("ScreenGui", { Name = "VolleyballDrag", ResetOnSpawn = false, DisplayOrder = 60, IgnoreGuiInset = false }, player:WaitForChild("PlayerGui"))

function Drag.target(gui, payload)
	Drag.targets[gui] = payload
end

local function dropTargetAt(pos)
	local ok, list = pcall(function()
		return player.PlayerGui:GetGuiObjectsAtPosition(pos.X, pos.Y)
	end)
	if not ok then
		return nil
	end
	for _, obj in list do
		local node = obj
		while node and node ~= player.PlayerGui do
			local payload = Drag.targets[node]
			if payload ~= nil and node.Visible then
				return payload
			end
			node = node.Parent
		end
	end
	return nil
end

function Drag.source(gui, payload, makeGhost, onClick, onDrop)
	gui.InputBegan:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then
			return
		end
		Drag.active = { gui = gui, payload = payload, start = Vector2.new(input.Position.X, input.Position.Y), makeGhost = makeGhost, onClick = onClick, onDrop = onDrop, input = input }
	end)
end

UserInputService.InputChanged:Connect(function(input)
	local d = Drag.active
	if not d or (input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch) then
		return
	end
	local pos = Vector2.new(input.Position.X, input.Position.Y)
	if not d.ghost and (pos - d.start).Magnitude > 8 then
		d.ghost = d.makeGhost and d.makeGhost() or frame({ Size = UDim2.fromOffset(60, 60), BackgroundColor3 = COL.teal }, nil)
		d.ghost.AnchorPoint = Vector2.new(0.5, 0.5)
		d.ghost.ZIndex = 50
		d.ghost.Parent = Drag.gui
	end
	if d.ghost then
		d.ghost.Position = UDim2.fromOffset(pos.X, pos.Y)
	end
end)

UserInputService.InputEnded:Connect(function(input)
	local d = Drag.active
	if not d or (input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch) then
		return
	end
	Drag.active = nil
	if d.ghost then
		d.ghost:Destroy()
		local target = dropTargetAt(Vector2.new(input.Position.X, input.Position.Y))
		if target ~= nil and d.onDrop then
			d.onDrop(d.payload, target)
		end
	elseif d.onClick then
		d.onClick(d.payload)
	end
end)

-- dark text on light colours, white on dark ones
local function contrast(color)
	return (color.R * 0.3 + color.G * 0.59 + color.B * 0.11) > 0.62 and COL.ink or Color3.new(1, 1, 1)
end

-- a straight line between two pixel points inside a frame
local function lineBetween(parent, a, b, thickness, color, transparency)
	local d = b - a
	return frame({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset((a.X + b.X) / 2, (a.Y + b.Y) / 2),
		Size = UDim2.fromOffset(d.Magnitude, thickness),
		Rotation = math.deg(math.atan2(d.Y, d.X)),
		BackgroundColor3 = color,
		BackgroundTransparency = transparency or 0,
	}, parent)
end

-- team crest: a roundel in the club colours with its short name
local function badge(parent, teamId, size, pos, anchor)
	local def = Teams.list[teamId]
	local b = frame({
		Size = UDim2.fromOffset(size, size),
		Position = pos or UDim2.new(),
		AnchorPoint = anchor or Vector2.zero,
		BackgroundColor3 = def.primary,
	}, parent)
	round(b, size)
	make("UIStroke", { Color = def.secondary, Thickness = math.max(2, math.floor(size * 0.07)) }, b)
	local ring = frame({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.74, 0.74), BackgroundTransparency = 1 }, b)
	round(ring, size)
	make("UIStroke", { Color = contrast(def.primary), Thickness = 1, Transparency = 0.55 }, ring)
	text({ Size = UDim2.fromScale(1, 1), Text = def.short, FontFace = FONT.title, TextSize = math.max(10, math.floor(size * 0.3)), TextColor3 = contrast(def.primary) }, b)
	return b
end

-- a shirt in a colour with a number on it
local function shirt(parent, color, number, size, pos)
	local holder = frame({ Size = UDim2.fromOffset(size, size), Position = pos, AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1 }, parent)
	for _, sx in { -1, 1 } do
		local sleeve = frame({
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.new(0.5 + sx * 0.33, 0, 0.06, 0),
			Size = UDim2.fromScale(0.28, 0.34),
			Rotation = sx * 30,
			BackgroundColor3 = color,
		}, holder)
		round(sleeve, 3)
	end
	local body = frame({ AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0.04), Size = UDim2.fromScale(0.56, 0.92), BackgroundColor3 = color }, holder)
	round(body, math.max(2, math.floor(size * 0.08)))
	local collar = frame({ AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0), Size = UDim2.fromScale(0.4, 0.1), BackgroundColor3 = COL.ink, BackgroundTransparency = 0.35 }, body)
	round(collar, 6)
	text({ Position = UDim2.fromScale(0, 0.12), Size = UDim2.fromScale(1, 0.8), Text = tostring(number), FontFace = FONT.num, TextSize = math.max(9, math.floor(size * 0.42)), TextColor3 = contrast(color) }, body)
	return holder
end

-- five stars, filled in halves
local function starRow(parent, stars, size, pos, anchor)
	local holder = frame({ Size = UDim2.fromOffset(size * 5, size), Position = pos, AnchorPoint = anchor or Vector2.zero, BackgroundTransparency = 1 }, parent)
	for i = 1, 5 do
		local cell = frame({ Position = UDim2.fromOffset((i - 1) * size, 0), Size = UDim2.fromOffset(size, size), BackgroundTransparency = 1 }, holder)
		text({ Size = UDim2.fromScale(1, 1), Text = "★", TextSize = size, TextColor3 = COL.dim, TextTransparency = 0.6 }, cell)
		local fill = math.clamp(stars - (i - 1), 0, 1)
		if fill > 0 then
			local clip = frame({ Size = UDim2.new(fill, 0, 1, 0), BackgroundTransparency = 1, ClipsDescendants = true }, cell)
			text({ Size = UDim2.fromOffset(size, size), Text = "★", TextSize = size, TextColor3 = COL.gold }, clip)
		end
	end
	return holder
end

-- a bar coloured by how high the value is, like a ratings bar
local function ratingColor(v)
	if v >= 80 then
		return Color3.fromRGB(70, 210, 90)
	elseif v >= 70 then
		return Color3.fromRGB(170, 220, 70)
	elseif v >= 60 then
		return Color3.fromRGB(240, 200, 60)
	elseif v >= 50 then
		return Color3.fromRGB(245, 140, 60)
	end
	return Color3.fromRGB(235, 70, 70)
end

local function ordinal(n)
	local suffix = "TH"
	if n % 100 < 11 or n % 100 > 13 then
		suffix = ({ "ST", "ND", "RD" })[n % 10] or "TH"
	end
	return n .. suffix
end

---------------------------------------------------------------- ball, shadow and markers (only you see these)

local world = Instance.new("Folder")
world.Name = "VolleyballLocal"
world.Parent = workspace

local function worldPart(props)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = Enum.Material.SmoothPlastic
	for key, value in props do
		p[key] = value
	end
	p.Parent = world
	return p
end

local FLAT = CFrame.Angles(0, 0, math.pi / 2) -- turns a cylinder into a disc on the floor

local Ball = {}
Ball.part = worldPart({ Name = "Ball", Shape = Enum.PartType.Ball, Size = Vector3.one * (R * 2), Color = Color3.fromRGB(255, 214, 64), CastShadow = true })
-- two blue bands so you can see the ball spin
Ball.bands = {}
Ball.BAND_OFFSET = { CFrame.new(), CFrame.Angles(0, math.pi / 2, 0) }
for i = 1, 2 do
	Ball.bands[i] = worldPart({ Name = "Band", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.12, R * 2 + 0.03, R * 2 + 0.03), Color = Color3.fromRGB(40, 90, 210) })
end
Ball.shadow = worldPart({ Name = "BallShadow", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.04, 2, 2), Color = Color3.new(0, 0, 0), Transparency = 0.6 })
Ball.marker = worldPart({ Name = "LandingMarker", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.03, 3.4, 3.4), Color = Color3.new(1, 1, 1), Material = Enum.Material.Neon, Transparency = 1 })
Ball.aim = worldPart({ Name = "AimMarker", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.03, 1.6, 1.6), Material = Enum.Material.Neon, Transparency = 1 })
-- a streak behind fast balls (gold for power shots)
do
	local top = make("Attachment", { Position = Vector3.new(0, R * 0.8, 0) }, Ball.part)
	local bottom = make("Attachment", { Position = Vector3.new(0, -R * 0.8, 0) }, Ball.part)
	Ball.trail = make("Trail", {
		Attachment0 = top,
		Attachment1 = bottom,
		Lifetime = 0.22,
		LightEmission = 0.6,
		Transparency = NumberSequence.new(0.2, 1),
		Color = ColorSequence.new(Color3.new(1, 1, 1)),
		Enabled = false,
	}, Ball.part)
end
Ball.glow = make("Highlight", {
	Adornee = Ball.part,
	FillTransparency = 1,
	OutlineColor = Color3.new(1, 1, 1),
	OutlineTransparency = 0,
	DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
	Enabled = false,
}, Ball.part)

local function burst(pos, color, size)
	local p = worldPart({ Shape = Enum.PartType.Ball, Size = Vector3.one, CFrame = CFrame.new(pos), Color = color, Material = Enum.Material.Neon, Transparency = 0.35 })
	TweenService:Create(p, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = Vector3.one * size, Transparency = 1 }):Play()
	task.delay(0.35, function()
		p:Destroy()
	end)
end

local function ripple(pos, color)
	local p = worldPart({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.05, 1, 1),
		CFrame = CFrame.new(pos.X, GY + 0.06, pos.Z) * FLAT,
		Color = color,
		Material = Enum.Material.Neon,
		Transparency = 0.3,
	})
	TweenService:Create(p, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = Vector3.new(0.05, 7, 7), Transparency = 1 }):Play()
	task.delay(0.55, function()
		p:Destroy()
	end)
end

---------------------------------------------------------------- what the server tells us

local state = {
	active = false,
	phase = "idle",
	score = { 0, 0 },
	sets = { 0, 0 },
	serving = 1,
	server = 0,
	serverTeam = 0,
	serverIndex = 0,
	touches = 0,
	touchTeam = 0,
	roster = { {}, {} },
	deadline = 0,
	serveIndex = { 1, 0 },
	teamIds = { 1, 2 },
	lineups = { Teams.defaultLineup(), Teams.defaultLineup() },
	points = Config.POINTS_TO_WIN,
	setsToWin = Config.SETS_TO_WIN,
	teamSize = Config.TEAM_SIZE,
}
local ballState = { id = 0, mode = "hidden", p0 = C, v0 = Vector3.zero, t0 = 0, rest = C }
local lastTouch = { team = 0, index = 0 } -- who played the ball last, for the HUD

local inMenu = true
local openMenu, closeMenu -- defined with the menus

local function myEntry()
	for t = 1, 2 do
		for _, e in state.roster[t] or {} do
			if e.id == player.UserId then
				return e, t
			end
		end
	end
	return nil, 0
end

-- your team: from the list of people playing (you always control someone on it)
local function myTeam()
	local ctrl = state.controls and state.controls[tostring(player.UserId)]
	if ctrl then
		return ctrl.team
	end
	local _, t = myEntry()
	return t
end

local function myControl()
	return state.controls and state.controls[tostring(player.UserId)]
end

local function entryAt(team, index)
	for _, e in state.roster[team] or {} do
		if e.index == index then
			return e
		end
	end
	return nil
end

local function teamDef(team)
	return Teams.list[state.teamIds[team] or team] or Teams.list[1]
end

local function myServe()
	return state.phase == "serve" and state.server == player.UserId
end

-- you play with your own character
local function controlledModel()
	return player.Character
end

local function character()
	local model = controlledModel()
	local hum = model and model:FindFirstChildOfClass("Humanoid")
	local hrp = model and model:FindFirstChild("HumanoidRootPart")
	return hum, hrp
end

local function airborne(hum)
	return hum ~= nil and hum.FloorMaterial == Enum.Material.Air
end

local function ballAt(t)
	if state.paused and state.pausedAt then
		t = math.min(t, state.pausedAt) -- frozen while the match is paused
	end
	if ballState.mode == "fly" then
		local dt = math.max(t - ballState.t0, 0)
		local p = ballState.p0 + ballState.v0 * dt + Vector3.new(0, -0.5 * G * dt * dt, 0)
		if p.Y < FLOOR then
			p = Vector3.new(p.X, FLOOR, p.Z)
		end
		return p
	elseif ballState.mode == "hold" then
		local holder = ballState.holder
		local hrp = holder and holder.Parent and holder:FindFirstChild("HumanoidRootPart")
		if hrp then
			return (hrp.CFrame * CFrame.new(0.5, 0.4, -1.4)).Position
		end
	end
	return ballState.rest
end

local function landingPoint()
	local p0, v0 = ballState.p0, ballState.v0
	local disc = v0.Y * v0.Y + 2 * G * (p0.Y - FLOOR)
	if disc < 0 then
		return nil
	end
	local s = (v0.Y + math.sqrt(disc)) / G
	return p0 + v0 * s + Vector3.new(0, -0.5 * G * s * s, 0)
end

local lastInput = (UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled) and "touch" or "kbm"
UserInputService.LastInputTypeChanged:Connect(function(inputType)
	if inputType == Enum.UserInputType.Touch then
		lastInput = "touch"
	elseif string.find(inputType.Name, "Gamepad") then
		lastInput = "pad"
	elseif inputType == Enum.UserInputType.Keyboard or string.find(inputType.Name, "Mouse") then
		lastInput = "kbm"
	end
end)

