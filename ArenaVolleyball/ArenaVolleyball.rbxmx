		Position = HUD.touchMode and UDim2.new(0.5, 0, 0, 12) or UDim2.new(0, 70, 1, -72),
		Size = UDim2.fromOffset(244, 54),
		BackgroundTransparency = 1,
	}, hud)
	-- stamina: jumping and diving use it, it comes back while you're on the ground
	local stam = frame({ Position = UDim2.fromOffset(0, HUD.touchMode and 30 or 0), Size = UDim2.fromOffset(244, 22), BackgroundColor3 = COL.bg2, BackgroundTransparency = 0.15 }, box)
	round(stam, 4)
	HUD.staminaStroke = outline(stam, COL.coral, 2, 1)
	HUD.staminaFill = frame({ Size = UDim2.fromScale(1, 1), BackgroundColor3 = COL.win }, stam)
	round(HUD.staminaFill, 4)
	HUD.staminaText = text({ Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -20, 1, 0), Text = "STAMINA", FontFace = FONT.title, TextSize = 13, TextXAlignment = LEFT, TextStrokeTransparency = 0.6 }, stam)
	HUD.staminaValue = text({ Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -20, 1, 0), Text = "100", FontFace = FONT.num, TextSize = 14, TextXAlignment = RIGHT, TextStrokeTransparency = 0.6 }, stam)
	HUD.staminaBox = stam

	local pill = frame({ Position = UDim2.fromOffset(0, HUD.touchMode and 0 or 28), Size = UDim2.fromOffset(244, 22), BackgroundColor3 = COL.bg2, BackgroundTransparency = 0.15 }, box)
	round(pill, 4)
	HUD.abilityStroke = outline(pill, COL.gold, 2, 1)
	HUD.abilityFill = frame({ Size = UDim2.fromScale(0, 1), BackgroundColor3 = COL.violet }, pill)
	round(HUD.abilityFill, 4)
	HUD.abilityName = text({ Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -50, 1, 0), FontFace = FONT.title, TextSize = 13, TextXAlignment = LEFT, TextStrokeTransparency = 0.6 }, pill)
	local chip = frame({ AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -4, 0.5, 0), Size = UDim2.fromOffset(30, 16), BackgroundColor3 = COL.gold, Visible = false }, pill)
	round(chip, 8)
	HUD.abilityKey = text({ Size = UDim2.fromScale(1, 1), FontFace = FONT.title, TextSize = 11, TextColor3 = COL.ink, Text = "R" }, chip)
	HUD.abilityChip = chip
	HUD.abilityPill = box
end


-- "POWER SPIKE · #7 SILVA" when anyone uses an ability
do
	local notice = frame({ AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, HUD.touchMode and 76 or 24), Size = UDim2.fromOffset(400, 34), BackgroundColor3 = Color3.new(1, 1, 1), Visible = false }, hud)
	HUD.noticeGradient = gradient(notice, COL.violet, COL.bg1, 0)
	HUD.noticeText = text({ Size = UDim2.fromScale(1, 1), FontFace = FONT.title, TextSize = 18 }, notice)
	HUD.notice = notice
end
local noticeToken = 0
function HUD.showNotice(message, color)
	noticeToken += 1
	local token = noticeToken
	HUD.noticeText.Text = message
	HUD.noticeGradient.Color = ColorSequence.new(color or COL.violet, COL.bg1)
	HUD.notice.Visible = true
	task.delay(2, function()
		if noticeToken == token then
			HUD.notice.Visible = false
		end
	end)
end

---------------------------------------------------------------- refreshing the HUD

local lastScore = ""
function HUD.refresh()
	local home, away = teamDef(1), teamDef(2)
	HUD.homeName.Text, HUD.awayName.Text = home.short, away.short
	HUD.homeStripe.BackgroundColor3, HUD.awayStripe.BackgroundColor3 = home.primary, away.primary
	local score = state.score[1] .. " - " .. state.score[2]
	HUD.score.Text = score
	if score ~= lastScore and lastScore ~= "" then
		HUD.scorePop.Scale = 1.2
		TweenService:Create(HUD.scorePop, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	end
	lastScore = score
	HUD.homeServe.Visible = state.serving == 1
	HUD.awayServe.Visible = state.serving == 2
	HUD.setLabel.Text = "SET " .. (state.sets[1] + state.sets[2] + 1)
	local target = "FIRST TO " .. (state.points or 25)
	if (state.setsToWin or 1) > 1 then
		target ..= "   ·   SETS " .. state.sets[1] .. "-" .. state.sets[2]
	end
	local mine = myTeam()
	if mine ~= 0 and state.serveIndex then
		-- which rotation your team is in (1 = the lineup as it started)
		local rotation = ((state.serveIndex[mine] or 1) - 1) % 6 + 1
		target ..= "   ·   ROTATION " .. rotation
	end
	HUD.target.Text = target
	local showDots = state.phase == "rally" and state.touchTeam ~= 0 and state.touches > 0
	for i = 1, 3 do
		local used = showDots and i <= state.touches
		HUD.dots[i].BackgroundColor3 = used and teamDef(state.touchTeam).primary or COL.text
		HUD.dots[i].BackgroundTransparency = used and 0 or 0.8
	end

	local me = myEntry()
	local team = myTeam()
	if not HUD.touchMode then
		fillPanel(HUD.me, me, team)
		-- the opponent on the ball: their server, or whoever touched it last
		local opp = 3 - team
		local focus
		if state.serverTeam == opp then
			focus = entryAt(opp, state.serverIndex)
		elseif lastTouch.team == opp then
			focus = entryAt(opp, lastTouch.index)
		end
		fillPanel(HUD.them, focus or entryAt(opp, 1), opp)
	end
	if me then
		HUD.tagArrow.TextColor3 = teamDef(team).primary
	end
end

local function radarPoint(pos, s)
	local x = 0.5 + (pos.X - C.X) * s / (2 * HALF_W)
	local y = 0.5 + (pos.Z - C.Z) * s / (2 * HALF_L)
	return UDim2.fromScale(math.clamp(x, -0.15, 1.15), math.clamp(y, -0.08, 1.08))
end

function HUD.update(t, ballPos)
	local me = myEntry()
	local team = myTeam()
	local s = team == 2 and -1 or 1
	-- radar
	HUD.radar.Visible = settings.radar
	if settings.radar then
		local seen = {}
		for tm = 1, 2 do
			for _, e in state.roster[tm] or {} do
				local model = e.model
				local hrp = model and model.Parent and model:FindFirstChild("HumanoidRootPart")
				if hrp then
					local key = tm * 10 + e.index
					seen[key] = true
					local dot = HUD.radarDots[key]
					if not dot then
						dot = frame({ AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(7, 7), ZIndex = 2 }, HUD.radarCourt)
						round(dot, 4)
						make("UIStroke", { Color = Color3.new(1, 1, 1), Thickness = 1.5, Enabled = false }, dot)
						HUD.radarDots[key] = dot
					end
					local isMe = e == me
					dot.Visible = true
					dot.BackgroundColor3 = teamDef(tm).primary
					dot.Size = isMe and UDim2.fromOffset(10, 10) or UDim2.fromOffset(7, 7)
					dot.UIStroke.Enabled = isMe
					dot.Position = radarPoint(hrp.Position, s)
				end
			end
		end
		for key, dot in HUD.radarDots do
			if not seen[key] then
				dot.Visible = false
			end
		end
		HUD.radarBall.Visible = ballState.mode ~= "hidden"
		HUD.radarBall.Position = radarPoint(ballPos, s)
	end

	-- the indicator over the player you control, with his name like a football game
	local _, hrp = character()
	local show = not inMenu and me ~= nil and hrp ~= nil
	HUD.tag.Enabled = show
	if show then
		HUD.tag.Adornee = hrp
		HUD.tagName.Text = me.name
	end
	local stamina = math.clamp(HUD.stamina or 1, 0, 1)
	local lowColor = stamina < 0.25 and COL.coral or Color3.fromRGB(70, 150, 255)
	HUD.tagStamina.Size = UDim2.fromScale(stamina, 1)
	HUD.tagStamina.BackgroundColor3 = lowColor
	HUD.me.bar.Size = UDim2.fromScale(stamina, 1)
	HUD.me.bar.BackgroundColor3 = lowColor
	-- the big stamina bar: green, then yellow, then flashing red
	HUD.staminaFill.Size = UDim2.fromScale(math.max(stamina, 0.02), 1)
	HUD.staminaFill.BackgroundColor3 = stamina < 0.25 and COL.loss or stamina < 0.55 and COL.gold or COL.win
	HUD.staminaValue.Text = tostring(math.floor(stamina * 100 + 0.5))
	HUD.staminaStroke.Transparency = stamina < 0.25 and (0.3 + 0.3 * math.sin(t * 10)) or 1
	HUD.staminaText.Text = stamina < 0.25 and "STAMINA  ·  TIRED" or "STAMINA"
	HUD.powerBack.Visible = HUD.power ~= nil
	if HUD.power then
		HUD.powerFill.Size = UDim2.fromScale(HUD.power, 1)
	end
	HUD.cue.Visible = state.phase == "rally" and t < HUD.cueUntil
	HUD.prompts.Visible = settings.hints and not HUD.touchMode
	-- ability meter
	HUD.abilityPill.Visible = me ~= nil
	if me then
		local meter = math.clamp((me.meter or 0) / 100, 0, 1)
		local ready = meter >= 1
		HUD.abilityFill.Size = UDim2.fromScale(meter, 1)
		HUD.abilityFill.BackgroundColor3 = ready and COL.gold or COL.violet
		HUD.abilityName.Text = me.boost and (me.boost .. "  ACTIVE") or (me.ability or "ABILITY")
		HUD.abilityName.TextColor3 = ready and COL.ink or COL.text
		HUD.abilityChip.Visible = ready and not me.boost
		HUD.abilityKey.Text = lastInput == "pad" and "Y" or (HUD.touchMode and "TAP" or "R")
		HUD.abilityStroke.Transparency = (ready or me.boost) and (0.3 + 0.3 * math.sin(t * 8)) or 1
	end
end

---------------------------------------------------------------- animations
-- Hand-made poses for passes, sets, spikes, tips, serves, blocks and dives. Each
-- player's screen layers them on every character (people and AI) over the normal
-- walk and run, so everyone sees the same thing. Angles are degrees; the fourth
-- number lowers or raises the body.

local Anim = {
	active = setmetatable({}, { __mode = "k" }),
	weights = setmetatable({}, { __mode = "k" }),
	motors = setmetatable({}, { __mode = "k" }),
}

local JOINTS = {
	Root = "LowerTorso",
	Waist = "UpperTorso",
	Neck = "Head",
	RightShoulder = "RightUpperArm",
	RightElbow = "RightLowerArm",
	RightWrist = "RightHand",
	LeftShoulder = "LeftUpperArm",
	LeftElbow = "LeftLowerArm",
	LeftWrist = "LeftHand",
	RightHip = "RightUpperLeg",
	RightKnee = "RightLowerLeg",
	LeftHip = "LeftUpperLeg",
	LeftKnee = "LeftLowerLeg",
}

local function J(rx, ry, rz, ty)
	return { rx or 0, ry or 0, rz or 0, ty or 0 }
end
local ZERO = J()

-- held positions, blended in and out automatically
local READY = {
	Root = J(0, 0, 0, -0.35), Waist = J(-12), Neck = J(10),
	RightHip = J(28), LeftHip = J(28), RightKnee = J(-48), LeftKnee = J(-48),
	RightShoulder = J(28, 0, 8), LeftShoulder = J(28, 0, -8), RightElbow = J(45), LeftElbow = J(45),
}
local COCK = {
	RightShoulder = J(160, 0, 25), RightElbow = J(115), LeftShoulder = J(135, 0, -12), LeftElbow = J(18),
	Waist = J(20, -15, 0), Neck = J(15),
	RightHip = J(-8), LeftHip = J(12), RightKnee = J(-55), LeftKnee = J(-40),
}
local BLOCK = {
	RightShoulder = J(168, 0, 10), LeftShoulder = J(168, 0, -10), RightElbow = J(4), LeftElbow = J(4),
	RightWrist = J(15), LeftWrist = J(15), Neck = J(8),
	RightHip = J(8), LeftHip = J(8), RightKnee = J(-25), LeftKnee = J(-25),
}
local TOSS = {
	LeftShoulder = J(150, 0, -6), LeftElbow = J(10), RightShoulder = J(150, 0, 30), RightElbow = J(110),
	Waist = J(14, -18, 0), Neck = J(25), RightHip = J(-6), LeftHip = J(14), LeftKnee = J(-18), RightKnee = J(-10),
}
local STRIKE = {
	RightShoulder = J(55, 0, 8), RightElbow = J(8), LeftShoulder = J(30, 0, -5), LeftElbow = J(40),
	Waist = J(-24, 12, 0), Neck = J(-5), RightHip = J(30), LeftHip = J(20), RightKnee = J(-35), LeftKnee = J(-30),
}
local DIVE = {
	Root = J(-70, 0, 0, -1.05), RightShoulder = J(165, 0, 12), LeftShoulder = J(165, 0, -12),
	RightHip = J(-12), LeftHip = J(-12), RightKnee = J(-30), LeftKnee = J(-30), Neck = J(45),
}

-- one-off moves: { seconds, pose } keyframes; `hold` keeps the last one until replaced
local POSES = {
	bump = { keys = {
		{ 0, {} },
		{ 0.1, {
			Root = J(0, 0, 0, -0.6), Waist = J(-18), RightHip = J(38), LeftHip = J(38), RightKnee = J(-70), LeftKnee = J(-70),
			RightShoulder = J(70, 0, -14), LeftShoulder = J(70, 0, 14), RightWrist = J(-10), LeftWrist = J(-10),
		} },
		{ 0.24, {
			Root = J(0, 0, 0, -0.25), Waist = J(-6), RightHip = J(18), LeftHip = J(18), RightKnee = J(-30), LeftKnee = J(-30),
			RightShoulder = J(92, 0, -14), LeftShoulder = J(92, 0, 14),
		} },
		{ 0.55, {} },
	} },
	set = { keys = {
		{ 0, {} },
		{ 0.12, {
			Root = J(0, 0, 0, -0.3), RightHip = J(16), LeftHip = J(16), RightKnee = J(-32), LeftKnee = J(-32),
			RightShoulder = J(150, 0, 22), LeftShoulder = J(150, 0, -22), RightElbow = J(85), LeftElbow = J(85),
			RightWrist = J(-30), LeftWrist = J(-30), Neck = J(22),
		} },
		{ 0.24, {
			Root = J(0, 0, 0, 0.05), RightKnee = J(-6), LeftKnee = J(-6),
			RightShoulder = J(172, 0, 10), LeftShoulder = J(172, 0, -10), RightElbow = J(12), LeftElbow = J(12), Neck = J(18),
		} },
		{ 0.55, {} },
	} },
	spike = { keys = { { 0, COCK }, { 0.07, STRIKE }, { 0.45, {} } } },
	jumpserve = { keys = { { 0, COCK }, { 0.07, STRIKE }, { 0.5, {} } } },
	tip = { keys = {
		{ 0, { RightShoulder = J(150, 0, 20), RightElbow = J(70), LeftShoulder = J(120, 0, -10), Waist = J(10) } },
		{ 0.14, { RightShoulder = J(172, 0, 6), RightElbow = J(5), RightWrist = J(35), LeftShoulder = J(80, 0, -10) } },
		{ 0.45, {} },
	} },
	serveprep = { hold = 3.5, keys = { { 0, {} }, { 0.35, TOSS } } },
	serve = { keys = {
		{ 0, TOSS },
		{ 0.09, { RightShoulder = J(150, 0, 5), RightElbow = J(5), LeftShoulder = J(60, 0, -10), LeftElbow = J(30), Waist = J(-8, 10, 0), Neck = J(10) } },
		{ 0.25, { RightShoulder = J(40, 0, -10), RightElbow = J(20), LeftShoulder = J(30, 0, -10), Waist = J(-16, 12, 0), RightHip = J(20) } },
		{ 0.6, {} },
	} },
	dive = { keys = { { 0, {} }, { 0.14, DIVE }, { 0.6, DIVE }, { 1, {} } } },
}

local function motorsOf(model)
	local cached = Anim.motors[model]
	if cached then
		return cached
	end
	cached = {}
	for joint, partName in JOINTS do
		local part = model:FindFirstChild(partName)
		local motor = part and part:FindFirstChild(joint)
		if motor and motor:IsA("Motor6D") then
			cached[joint] = motor
		end
	end
	Anim.motors[model] = cached
	return cached
end

local function addTo(out, joint, a, b, x, weight)
	local acc = out[joint]
	if not acc then
		acc = { 0, 0, 0, 0 }
		out[joint] = acc
	end
	for i = 1, 4 do
		acc[i] += (a[i] + (b[i] - a[i]) * x) * weight
	end
end

local function addPose(out, pose, weight)
	if weight <= 0.001 then
		return
	end
	for joint, v in pose do
		addTo(out, joint, v, v, 0, weight)
	end
end

-- adds a one-off move at `tau` seconds; returns false once it has finished
local function addMove(out, move, tau)
	local keys = move.keys
	local last = keys[#keys]
	if tau >= last[1] then
		if move.hold and tau < last[1] + move.hold then
			addPose(out, last[2], 1)
			return true
		end
		return false
	end
	for i = 1, #keys - 1 do
		local a, b = keys[i], keys[i + 1]
		if tau >= a[1] and tau <= b[1] then
			local x = (tau - a[1]) / math.max(b[1] - a[1], 1e-3)
			x = x * x * (3 - 2 * x)
			for joint, va in a[2] do
				addTo(out, joint, va, b[2][joint] or ZERO, x, 1)
			end
			for joint, vb in b[2] do
				if not a[2][joint] then
					addTo(out, joint, ZERO, vb, x, 1)
				end
			end
			break
		end
	end
	return true
end

-- Your own animation for a move (Config.ANIMATIONS), loaded once per character
Anim.tracks = setmetatable({}, { __mode = "k" })
local function customTrack(model, kind)
	local id = Config.ANIMATIONS and tonumber(Config.ANIMATIONS[kind])
	if not id or id <= 0 then
		return nil
	end
	local hum = model:FindFirstChildOfClass("Humanoid")
	local animator = hum and hum:FindFirstChildOfClass("Animator")
	if not animator then
		return nil
	end
	local cache = Anim.tracks[model]
	if not cache then
		cache = {}
		Anim.tracks[model] = cache
	end
	if cache[kind] == nil then
		local anim = Instance.new("Animation")
		anim.AnimationId = "rbxassetid://" .. id
		local ok, track = pcall(animator.LoadAnimation, animator, anim)
		if ok and track then
			track.Priority = Enum.AnimationPriority.Action
			cache[kind] = track
		else
			cache[kind] = false
		end
	end
	return cache[kind] or nil
end

function Anim.play(model, kind)
	if not model then
		return
	end
	-- with your own serve animation, the built-in toss isn't needed
	if kind == "serveprep" and customTrack(model, "serve") then
		return
	end
	local track = customTrack(model, kind)
	if track then
		track:Play(0.1)
		Anim.active[model] = nil
		return
	end
	local move = POSES[kind]
	if move then
		Anim.active[model] = { move = move, t0 = os.clock() }
	end
end

-- which held position a character should be in right now
local function autoTargets(team, hum, hrp, ballPos)
	if state.phase ~= "rally" or ballState.mode ~= "fly" then
		return 0, 0, 0
	end
	local s = team == 1 and 1 or -1
	local stand = GY + hum.HipHeight + hrp.Size.Y / 2
	local depth = (hrp.Position.Z - C.Z) * s
	local ballSide = (ballPos.Z - C.Z) * s
	if hrp.Position.Y > stand + 1 then
		if depth < 4.5 and ballSide < 2 then
			return 0, 0, 1 -- jumping at the net while they attack: block
		end
		return 0, (ballSide > -1) and 1 or 0, 0 -- in the air on our side: wind up
	end
	local v = hrp.AssemblyLinearVelocity
	local speed = Vector3.new(v.X, 0, v.Z).Magnitude
	return math.clamp(1 - (speed - 5) / 6, 0, 1), 0, 0 -- standing or shuffling: ready crouch
end

function Anim.step(dt, ballPos)
	local now = os.clock()
	local blend = math.min(1, dt * 10)
	for team = 1, 2 do
		for _, e in state.roster[team] or {} do
			local model = e.model
			local hum = model and model.Parent and model:FindFirstChildOfClass("Humanoid")
			local hrp = hum and model:FindFirstChild("HumanoidRootPart")
			if hrp then
				local motors = motorsOf(model)
				local out = {}
				local w = Anim.weights[model]
				if not w then
					w = { ready = 0, cock = 0, block = 0, seed = math.random() * 10 }
					Anim.weights[model] = w
				end
				local ready, cock, block = autoTargets(team, hum, hrp, ballPos)
				local active = Anim.active[model]
				if active and not addMove(out, active.move, now - active.t0) then
					Anim.active[model] = nil
					active = nil
				end
				if active then
					ready, cock, block = 0, 0, 0
					w.cock, w.block, w.ready = 0, 0, 0 -- the move takes over at once
				end
				w.ready += (ready - w.ready) * blend
				w.cock += (cock - w.cock) * blend
				w.block += (block - w.block) * blend
				addPose(out, READY, w.ready * (0.85 + 0.15 * math.sin(now * 2.1 + w.seed)))
				addPose(out, COCK, w.cock)
				-- your block animation plays once per jump instead of the held pose
				local blockTrack = customTrack(model, "block")
				if blockTrack then
					if block > 0.5 and not w.blocking then
						blockTrack:Play(0.1)
					end
					w.blocking = block > 0.5
				else
					addPose(out, BLOCK, w.block)
				end
				for joint, v in out do
					local motor = motors[joint]
					if motor then
						motor.Transform = motor.Transform * CFrame.new(0, v[4], 0) * CFrame.Angles(math.rad(v[1]), math.rad(v[2]), math.rad(v[3]))
					end
				end
			end
		end
	end
end

---------------------------------------------------------------- controls

local Controls = { charging = false, chargeStart = 0, lastSend = 0, lastDive = 0, diveUntil = 0, pending = nil }
local showPause -- the pause screen, defined with the menus

local function chargePower()
	return math.clamp((os.clock() - Controls.chargeStart) / 1.2, 0, 1)
end

-- Where you're aiming on the floor: the mouse, or the middle of the screen on touch / gamepad
local function aimPoint()
	local cam = workspace.CurrentCamera
	local ray
	if lastInput == "kbm" and UserInputService.MouseBehavior ~= Enum.MouseBehavior.LockCenter then
		local m = UserInputService:GetMouseLocation()
		ray = cam:ViewportPointToRay(m.X, m.Y)
	else
		ray = cam:ViewportPointToRay(cam.ViewportSize.X / 2, cam.ViewportSize.Y * 0.45)
	end
	local o, d = ray.Origin, ray.Direction
	if d.Y < -0.02 then
		return o + d * ((GY - o.Y) / d.Y)
	end
	local flat = Vector3.new(d.X, 0, d.Z)
	if flat.Magnitude < 1e-3 then
		flat = Vector3.new(0, 0, -1)
	end
	return Vector3.new(o.X, GY, o.Z) + flat.Unit * 40
end

-- Same windows the server uses: can you play this touch right now?
local WINDOWS = { bump = { -3.5, 5 }, set = { -2, 7 }, spike = { -2.5, 8 }, tip = { -2.5, 8 } }
local function canPlay(kind, hrp)
	if not hrp or state.phase ~= "rally" or ballState.mode ~= "fly" then
		return false
	end
	local team = myTeam()
	local pos = ballAt(serverNow())
	if team == 0 or (pos.Z - C.Z) * (team == 1 and 1 or -1) < -1.5 then
		return false
	end
	local off = pos - hrp.Position
	local win = WINDOWS[kind]
	return Vector3.new(off.X, 0, off.Z).Magnitude <= REACH + 1.2 and off.Y > win[1] and off.Y < win[2]
end

-- a press made slightly early is played the moment the ball arrives
local function sendHit(kind)
	local hum, hrp = character()
	local air = airborne(hum) and os.clock() > Controls.diveUntil
	if not air and (kind == "spike" or kind == "tip") then
		kind = (kind == "spike") and "bump" or "set"
	end
	if os.clock() - Controls.lastSend < 0.3 then
		return
	end
	if not canPlay(kind, hrp) then
		Controls.pending = { kind = kind, expires = os.clock() + 0.3 }
		return
	end
	Controls.pending = nil
	Controls.lastSend = os.clock()
	remote:FireServer("hit", { kind = kind, aim = aimPoint(), root = hrp.Position, air = air, id = ballState.id, t = serverNow() })
end

local function press()
	if inMenu then
		return
	end
	if myServe() then
		if ballState.mode == "hold" and not Controls.charging then
			Controls.charging = true
			Controls.chargeStart = os.clock()
			local hum = character()
			if hum and hum.Parent then
				Anim.play(hum.Parent, "serveprep")
			end
			remote:FireServer("prep", {})
		end
		return
	end
	sendHit("spike") -- in the air this spikes; on the ground it becomes a pass
end

local function release()
	if not Controls.charging then
		return
	end
	Controls.charging = false
	local hum, hrp = character()
	if not hrp or not myServe() then
		return
	end
	remote:FireServer("serve", { aim = aimPoint(), power = chargePower(), root = hrp.Position, air = airborne(hum) })
end

local function setBall()
	if not inMenu and not myServe() then
		sendHit("tip") -- in the air this tips over the block; on the ground it sets
	end
end

---------------------------------------------------------------- stamina and jumping
-- Jumping and diving use stamina and it comes back on the ground. Tired legs don't jump
-- as high; with too little left you can't jump, and you can't jump again straight
-- after landing (no bunny hopping).

local Stamina = { value = 100 }
local JUMP_COST, REPEAT_COST, DIVE_COST = 14, 10, 20
local Pilot = { lastAir = false, landedAt = 0, lastJump = 0, tiredNote = 0, base = setmetatable({}, { __mode = "k" }) }

UserInputService.JumpRequest:Connect(function()
	local hum = character()
	if inMenu or not hum or airborne(hum) then
		return
	end
	if Stamina.value < JUMP_COST and os.clock() - Pilot.tiredNote > 1.5 then
		Pilot.tiredNote = os.clock()
		HUD.flash("TOO TIRED TO JUMP", COL.coral)
	end
end)

-- runs every frame on your character; returns its humanoid
function Pilot.update(dt)
	local hum, hrp = character()
	if not hum or not hrp then
		Pilot.lastAir = false
		return nil
	end
	if not Pilot.base[hum] then
		Pilot.base[hum] = { power = hum.JumpPower, height = hum.JumpHeight }
	end
	local air = airborne(hum)
	if air and not Pilot.lastAir then
		if hrp.AssemblyLinearVelocity.Y > 5 and not inMenu then
			local again = os.clock() - Pilot.lastJump < 1.6
			Stamina.value = math.max(0, Stamina.value - JUMP_COST - (again and REPEAT_COST or 0))
			Pilot.lastJump = os.clock()
		end
	elseif not air and Pilot.lastAir then
		Pilot.landedAt = os.clock()
	end
	Pilot.lastAir = air
	-- jumping is switched off for a moment after landing, and when you're out of stamina
	local canJump = inMenu or (os.clock() - Pilot.landedAt >= 0.4 and Stamina.value >= JUMP_COST)
	hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, canJump)
	return hum
end

function Stamina.update(dt, hum)
	if hum and not airborne(hum) then
		local still = hum.MoveDirection.Magnitude < 0.1
		Stamina.value = math.min(100, Stamina.value + (still and 14 or 8) * dt)
	end
	local base = hum and Pilot.base[hum]
	if base then
		local scale = (Stamina.value < 25 and not inMenu) and 0.78 or 1
		hum.JumpPower = base.power * scale
		hum.JumpHeight = base.height * scale
	end
	HUD.stamina = Stamina.value / 100
end

local function dive()
	local hum, hrp = character()
	if inMenu or not hum or not hrp or state.phase ~= "rally" then
		return
	end
	if os.clock() - Controls.lastDive < 1.4 or airborne(hum) or Stamina.value < DIVE_COST then
		return
	end
	local dir = hum.MoveDirection
	if dir.Magnitude < 0.1 then
		dir = hrp.CFrame.LookVector
	end
	dir = Vector3.new(dir.X, 0, dir.Z)
	if dir.Magnitude < 0.01 then
		return
	end
	Stamina.value -= DIVE_COST
	Controls.lastDive = os.clock()
	Controls.diveUntil = os.clock() + 0.7
	Anim.play(hum.Parent, "dive")
	remote:FireServer("dive", {})
	hrp.AssemblyLinearVelocity = dir.Unit * 42 + Vector3.new(0, 14, 0)
	local speed = hum.WalkSpeed
	task.delay(0.35, function()
		if hum.Parent then
			hum.WalkSpeed = 4
		end
	end)
	task.delay(0.9, function()
		if hum.Parent then
			hum.WalkSpeed = speed
		end
	end)
end

UserInputService.InputBegan:Connect(function(input, processed)
	if processed or inMenu then
		return
	end
	local key = input.KeyCode
	if key == Enum.KeyCode.M or key == Enum.KeyCode.ButtonStart then
		if showPause then
			showPause()
		end
	elseif state.paused then
		return -- nothing to do while the match is paused
	elseif key == Enum.KeyCode.R or key == Enum.KeyCode.ButtonY then
		remote:FireServer("ability", {})
	elseif key == Enum.KeyCode.F or key == Enum.KeyCode.DPadUp then
		remote:FireServer("call", {})
	elseif key == Enum.KeyCode.V then
		settings.camera = settings.camera == "broadcast" and "player" or "broadcast"
	elseif input.UserInputType == Enum.UserInputType.MouseButton1 or key == Enum.KeyCode.ButtonR2 then
		press()
	elseif key == Enum.KeyCode.E or key == Enum.KeyCode.ButtonX then
		setBall()
	elseif key == Enum.KeyCode.Q or key == Enum.KeyCode.C or key == Enum.KeyCode.ButtonB then
		dive()
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.KeyCode == Enum.KeyCode.ButtonR2 then
		release()
	end
end)

HUD.hitButton.MouseButton1Down:Connect(press)
HUD.hitButton.MouseButton1Up:Connect(release)
HUD.setButton.MouseButton1Down:Connect(setBall)
HUD.diveButton.MouseButton1Down:Connect(dive)

---------------------------------------------------------------- cameras
-- BROADCAST: a low chase camera behind your team that follows the play.
-- BEHIND PLAYER (V): Roblox's own camera on your character, with shift lock.

local Cam = { focus = nil, zoom = 1, ready = false, shakeUntil = 0, shakePower = 0, mode = nil }

function Cam.shake(power, seconds)
	Cam.shakePower = math.max(Cam.shakePower, power)
	Cam.shakeUntil = math.max(Cam.shakeUntil, os.clock() + seconds)
end

UserInputService.InputChanged:Connect(function(input, processed)
	if inMenu or settings.camera ~= "broadcast" then
		return
	end
	if input.UserInputType == Enum.UserInputType.MouseWheel and not processed then
		Cam.zoom = math.clamp(Cam.zoom - input.Position.Z * 0.06, 0.6, 1.4)
	end
end)

function Cam.update(dt, ballPos)
	if inMenu then
		Cam.mode = nil
		UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		return
	end
	local cam = workspace.CurrentCamera
	local team = myTeam()
	local hum, hrp = character()
	if team == 0 or not hrp or settings.camera == "player" then
		-- Roblox's own camera (shift lock works here)
		if Cam.mode ~= "player" then
			Cam.mode = "player"
			cam.CameraType = Enum.CameraType.Custom
			cam.FieldOfView = 70
		end
		local subject = hum
		if subject and cam.CameraSubject ~= subject then
			cam.CameraSubject = subject
		end
		return
	end
	if Cam.mode ~= "broadcast" then
		Cam.mode = "broadcast"
		UserInputService.MouseBehavior = Enum.MouseBehavior.Default
	end
	local s = team == 1 and 1 or -1
	local shake = Vector3.zero
	if os.clock() < Cam.shakeUntil then
		local p = Cam.shakePower * (Cam.shakeUntil - os.clock()) / 0.3
		shake = Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * p
	else
		Cam.shakePower = 0
	end
	cam.CameraType = Enum.CameraType.Scriptable
	-- follow a point between your player and the ball, kept on the court
	local ballOnOurSide = (ballPos.Z - C.Z) * s > 0
	local blend = ballOnOurSide and 0.45 or 0.3
	local target = hrp.Position:Lerp(ballPos, blend)
	local depth = math.clamp((target.Z - C.Z) * s, -4, HALF_L + 2)
	target = Vector3.new(math.clamp(target.X, C.X - HALF_W - 4, C.X + HALF_W + 4), GY, C.Z + s * depth)
	Cam.focus = Cam.focus and Cam.focus:Lerp(target, math.min(1, dt * 3)) or target
	local focusDepth = (Cam.focus.Z - C.Z) * s
	local eye = Vector3.new(C.X + (Cam.focus.X - C.X) * 0.75, GY + 15 * Cam.zoom, C.Z + s * (focusDepth + 26 * Cam.zoom))
	local look = Vector3.new(Cam.focus.X, GY + 3, C.Z + s * (focusDepth - 14))
	cam.FieldOfView = 62
	cam.CFrame = CFrame.lookAt(eye + shake, look)
end

local function updatePrompts()
	if myTeam() == 0 then
		HUD.setPrompts({})
		return
	end
	local pad = lastInput == "pad"
	if myServe() then
		local left = math.max(0, math.ceil(state.deadline - serverNow()))
		HUD.setPrompts({
			{ pad and "HOLD R2" or "HOLD CLICK", "Serve  (" .. left .. "s)" },
			{ pad and "A" or "SPACE", "Jump first: jump serve" },
			{ pad and "R-STICK" or "MOUSE", "Aim" },
		})
	elseif state.phase == "rally" then
		local me = myEntry()
		local ready = me and (me.meter or 0) >= 100
		HUD.setPrompts({
			{ pad and "R2" or "CLICK", "Pass · spike in the air" },
			{ pad and "X" or "E", "Set · tip in the air" },
			{ pad and "A" or "SPACE", "Jump · block at the net" },
			{ pad and "B" or "Q", "Dive" },
			ready and { pad and "Y" or "R", (me.ability or "Ability") .. " ready!" } or { pad and "UP" or "F", "Call for a quick set" },
		})
	else
		HUD.setPrompts({
			{ pad and "START" or "M", "Pause" },
			{ "V", settings.camera == "player" and "Broadcast camera" or "Behind-player camera" },
			settings.camera == "player" and { "SHIFT", "Shift lock" } or nil,
		})
	end
end

---------------------------------------------------------------- menus: the front end

local Menu = { screens = {}, onShow = {}, current = nil, stack = {}, waiting = false, pvTab = 1, squadSel = 2 }
-- what you've picked: your club, the opponent, your lineup and the player you control
local sel = {
	home = 1,
	away = 2,
	slot = 2,
	plan = Teams.cleanPlan(1, nil), -- lineup, tactics and roles for your club
	points = Config.POINTS_TO_WIN,
	sets = Config.SETS_TO_WIN,
	side = 1,
}
sel.lineup = sel.plan.lineup
local history = {} -- results this session: { home, away, winner, score }

-- a fresh game plan when you pick another club
local function resetPlan()
	sel.plan = Teams.cleanPlan(sel.home, nil)
	sel.lineup = sel.plan.lineup
	sel.slot = 2
end

Menu.gui = make("ScreenGui", {
	Name = "VolleyballMenu",
	ResetOnSpawn = false,
	IgnoreGuiInset = false,
	DisplayOrder = 5,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
}, player:WaitForChild("PlayerGui"))
-- the menus sit below Roblox's own buttons along the top
pcall(function()
	Menu.gui.ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets
end)

-- background: deep purple with neon swooshes, on its own full-screen layer
do
	local bgGui = make("ScreenGui", { Name = "VolleyballMenuBackground", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 4 }, player:WaitForChild("PlayerGui"))
	Menu.gui:GetPropertyChangedSignal("Enabled"):Connect(function()
		bgGui.Enabled = Menu.gui.Enabled
	end)
	local bg = frame({ Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1) }, bgGui)
	gradient(bg, COL.bg1, COL.bg2, 35)
	local floorGlow = frame({ AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.fromScale(1, 0.3), BackgroundColor3 = Color3.fromRGB(10, 8, 40) }, bg)
	make("UIGradient", { Rotation = 90, Transparency = NumberSequence.new(1, 0.25) }, floorGlow)
	local streaks = {
		{ 0.16, 0.2, 0.8, 0.04, COL.teal, 0.2 },
		{ 0.06, 0.32, 0.7, 0.07, COL.pink, 0.4 },
		{ 0.22, 0.1, 0.95, 0.012, COL.cyan, 0.3 },
		{ 0.66, 0.12, 0.7, 0.025, COL.violet, 0.5 },
		{ 0.8, 0.74, 0.6, 0.016, COL.teal, 0.55 },
		{ 0.3, 0.9, 0.9, 0.01, COL.pink, 0.5 },
	}
	for _, st in streaks do
		local f = frame({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(st[1], st[2]), Size = UDim2.fromScale(st[3], st[4]), Rotation = -28, BackgroundColor3 = st[5], BackgroundTransparency = st[6] }, bg)
		make("UIGradient", { Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0), NumberSequenceKeypoint.new(1, 1) }) }, f)
		round(f, 40)
	end
end

-- everything is laid out on a 1280 x 720 board scaled to the screen
local board = frame({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(1280, 720), BackgroundTransparency = 1 }, Menu.gui)
do
	local scale = make("UIScale", { Scale = 1 }, board)
	local function fit()
		local size = Menu.gui.AbsoluteSize
		if size.X < 10 then
			size = workspace.CurrentCamera.ViewportSize
		end
		scale.Scale = math.min(size.X / 1280, size.Y / 720)
	end
	fit()
	Menu.gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(fit)
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(fit)
end
Menu.board = board

function Menu.screen(name)
	local f = frame({ Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = false }, board)
	Menu.screens[name] = f
	return f
end

local FRONT = { home = true, play = true, online = true, customise = true }
function Menu.show(name, push)
	if Menu.current and push ~= false and Menu.current ~= name then
		table.insert(Menu.stack, Menu.current)
	end
	for n, f in Menu.screens do
		f.Visible = n == name
	end
	Menu.current = name
	if Menu.cover then
		Menu.cover.vp.Visible = FRONT[name] == true
	end
	local hook = Menu.onShow[name]
	if hook then
		hook()
	end
end

function Menu.back()
	local previous = table.remove(Menu.stack)
	if previous then
		Menu.show(previous, false)
	end
end

UserInputService.InputBegan:Connect(function(input, processed)
	if inMenu and not processed and (input.KeyCode == Enum.KeyCode.Backspace or input.KeyCode == Enum.KeyCode.ButtonB) then
		Menu.back()
	end
end)

---------------------------------------------------------------- menu building blocks

function Menu.tile(parent, pos, size, onClick)
	local t = button({ Position = pos, Size = size, BackgroundTransparency = 0.12, BackgroundColor3 = COL.panel, ClipsDescendants = true }, parent)
	local stroke = outline(t, COL.line, 1, 0.45)
	t.MouseEnter:Connect(function()
		stroke.Color, stroke.Transparency, stroke.Thickness = COL.teal, 0, 2
	end)
	t.MouseLeave:Connect(function()
		stroke.Color, stroke.Transparency, stroke.Thickness = COL.line, 0.45, 1
	end)
	if onClick then
		t.Activated:Connect(onClick)
	end
	return t
end

function Menu.title(parent, str, size, pos)
	return text({
		Position = pos or UDim2.fromOffset(16, 10),
		Size = UDim2.new(1, -32, 0, (size or 30) * 2 + 8),
		Text = str,
		FontFace = FONT.body,
		TextSize = size or 30,
		TextColor3 = COL.cyan,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		LineHeight = 0.95,
	}, parent)
end

function Menu.chip(parent, label, pos, color, textColor)
	local c = frame({ Position = pos, Size = UDim2.fromOffset(0, 24), AutomaticSize = Enum.AutomaticSize.X, BackgroundColor3 = color or COL.gold }, parent)
	round(c, 3)
	make("UIPadding", { PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12) }, c)
	text({ Size = UDim2.fromOffset(0, 24), AutomaticSize = Enum.AutomaticSize.X, Text = label, FontFace = FONT.title, TextSize = 12, TextColor3 = textColor or COL.ink }, c)
	return c
end

local TABS = { "HOME", "PLAY", "ONLINE", "CUSTOMISE" }
local TAB_SCREEN = { "home", "play", "online", "customise" }
function Menu.tabs(parent, pos, names, active, onPick, width)
	width = width or 112
	local bar = frame({ Position = pos, Size = UDim2.fromOffset(#names * width, 32), BackgroundColor3 = COL.bg2, BackgroundTransparency = 0.35 }, parent)
	for i, name in names do
		local b = button({ Position = UDim2.fromOffset((i - 1) * width, 0), Size = UDim2.fromOffset(width, 32), BackgroundColor3 = COL.bg2, BackgroundTransparency = i == active and 0.05 or 1 }, bar)
		text({ Size = UDim2.fromScale(1, 1), Text = name, FontFace = FONT.head, TextSize = 19, TextColor3 = i == active and COL.teal or COL.text }, b)
		if i == active then
			frame({ AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.new(1, 0, 0, 3), BackgroundColor3 = COL.coral }, b)
		end
		b.Activated:Connect(function()
			onPick(i)
		end)
	end
	return bar
end

function Menu.frontTabs(parent, active)
	return Menu.tabs(parent, UDim2.fromOffset(268, 160), TABS, active, function(i)
		Menu.show(TAB_SCREEN[i], false)
	end)
end

-- button hints along the bottom: { key, label, onClick }
function Menu.hints(parent, items, pos)
	local holder = frame({ Position = pos or UDim2.fromOffset(268, 632), Size = UDim2.fromOffset(1000, 28), BackgroundTransparency = 1 }, parent)
	make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 22), VerticalAlignment = Enum.VerticalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder }, holder)
	for i, item in items do
		-- each hint sizes itself to its text, so nothing overlaps or gets cut off
		local b = button({ Size = UDim2.fromOffset(0, 28), AutomaticSize = Enum.AutomaticSize.X, LayoutOrder = i }, holder)
		make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8), VerticalAlignment = Enum.VerticalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder }, b)
		local chip = frame({ Size = UDim2.fromOffset(0, 24), AutomaticSize = Enum.AutomaticSize.X, BackgroundColor3 = COL.text, LayoutOrder = 1 }, b)
		round(chip, 12)
		make("UIPadding", { PaddingLeft = UDim.new(0, 9), PaddingRight = UDim.new(0, 9) }, chip)
		text({ Size = UDim2.fromOffset(0, 24), AutomaticSize = Enum.AutomaticSize.X, Text = item[1], FontFace = FONT.title, TextSize = 12, TextColor3 = COL.ink }, chip)
		text({ Size = UDim2.fromOffset(0, 28), AutomaticSize = Enum.AutomaticSize.X, Text = item[2], FontFace = FONT.head, TextSize = 17, LayoutOrder = 2 }, b)
		if item[3] then
			b.Activated:Connect(item[3])
		end
	end
	return holder
end

-- simple line icons
function Menu.icon(parent, kind, size, color, pos)
	local box = frame({ AnchorPoint = Vector2.new(0.5, 0.5), Position = pos, Size = UDim2.fromOffset(size, size), BackgroundTransparency = 1 }, parent)
	local s = size
	if kind == "ball" then
		local c = frame({ Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1 }, box)
		round(c, s)
		make("UIStroke", { Color = color, Thickness = 2 }, c)
		lineBetween(box, Vector2.new(s * 0.1, s * 0.5), Vector2.new(s * 0.9, s * 0.5), 2, color)
		lineBetween(box, Vector2.new(s * 0.5, s * 0.08), Vector2.new(s * 0.5, s * 0.92), 2, color)
		local inner = frame({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.5, 0.5), BackgroundTransparency = 1 }, box)
		round(inner, s)
		make("UIStroke", { Color = color, Thickness = 2 }, inner)
	elseif kind == "court" then
		local c = frame({ Size = UDim2.fromScale(1, 0.7), Position = UDim2.fromScale(0, 0.15), BackgroundTransparency = 1 }, box)
		make("UIStroke", { Color = color, Thickness = 2 }, c)
		frame({ AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0), Size = UDim2.new(0, 2, 1, 0), BackgroundColor3 = color }, c)
		for _, x in { 0.25, 0.75 } do
			local d = frame({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(x, 0.5), Size = UDim2.fromOffset(5, 5), BackgroundColor3 = color }, c)
			round(d, 3)
		end
	elseif kind == "sliders" then
		for i, x in { 0.3, 0.7, 0.45 } do
			local y = s * (0.2 + (i - 1) * 0.3)
			lineBetween(box, Vector2.new(0, y), Vector2.new(s, y), 2, color)
			local k = frame({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(s * x, y), Size = UDim2.fromOffset(8, 8), BackgroundColor3 = color }, box)
			round(k, 4)
		end
	elseif kind == "pad" then
		local body = frame({ Size = UDim2.fromScale(1, 0.62), Position = UDim2.fromScale(0, 0.2), BackgroundTransparency = 1 }, box)
		round(body, math.floor(s * 0.3))
		make("UIStroke", { Color = color, Thickness = 2 }, body)
		lineBetween(box, Vector2.new(s * 0.18, s * 0.5), Vector2.new(s * 0.38, s * 0.5), 2, color)
		lineBetween(box, Vector2.new(s * 0.28, s * 0.4), Vector2.new(s * 0.28, s * 0.6), 2, color)
		for _, p in { { 0.7, 0.42 }, { 0.8, 0.55 } } do
			local d = frame({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(p[1], p[2]), Size = UDim2.fromOffset(5, 5), BackgroundColor3 = color }, box)
			round(d, 3)
		end
	elseif kind == "bars" then
		for i, h in { 0.45, 0.75, 1 } do
			frame({ AnchorPoint = Vector2.new(0, 1), Position = UDim2.new((i - 1) * 0.36, 0, 1, 0), Size = UDim2.new(0.24, 0, h, 0), BackgroundColor3 = color }, box)
		end
	elseif kind == "arena" then
		local c = frame({ Position = UDim2.fromScale(0.1, 0.45), Size = UDim2.fromScale(0.8, 0.5), BackgroundTransparency = 1 }, box)
		make("UIStroke", { Color = color, Thickness = 2 }, c)
		lineBetween(box, Vector2.new(s * 0.05, s * 0.48), Vector2.new(s * 0.5, s * 0.12), 2, color)
		lineBetween(box, Vector2.new(s * 0.5, s * 0.12), Vector2.new(s * 0.95, s * 0.48), 2, color)
	elseif kind == "clock" then
		local c = frame({ Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1 }, box)
		round(c, s)
		make("UIStroke", { Color = color, Thickness = 2 }, c)
		lineBetween(box, Vector2.new(s * 0.5, s * 0.5), Vector2.new(s * 0.5, s * 0.2), 2, color)
		lineBetween(box, Vector2.new(s * 0.5, s * 0.5), Vector2.new(s * 0.72, s * 0.6), 2, color)
	end
	return box
end

local toast = text({
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 16),
	Size = UDim2.fromOffset(0, 38),
	AutomaticSize = Enum.AutomaticSize.X,
	BackgroundColor3 = COL.bg1,
	BackgroundTransparency = 1,
	FontFace = FONT.head,
	TextSize = 18,
	TextTransparency = 1,
	ZIndex = 40,
}, Menu.gui)
round(toast, 6)
make("UIPadding", { PaddingLeft = UDim.new(0, 20), PaddingRight = UDim.new(0, 20) }, toast)
function Menu.toast(message)
	toast.Text = message
	toast.TextTransparency, toast.BackgroundTransparency = 0, 0.05
	TweenService:Create(toast, TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.In, 0, false, 1.6), { TextTransparency = 1, BackgroundTransparency = 1 }):Play()
end

---------------------------------------------------------------- 3D players in the menus

-- strips scripts and sounds from a copied character and stands it still
local function prepareModel(model)
	for _, d in model:GetDescendants() do
		if d:IsA("BaseScript") or d:IsA("ModuleScript") or d:IsA("Sound") or d:IsA("ForceField") or d:IsA("BillboardGui") then
			d:Destroy()
		end
	end
	local hrp = model:FindFirstChild("HumanoidRootPart")
	if hrp then
		hrp.Anchored = true
	end
	return model:FindFirstChildOfClass("Humanoid"), hrp
end

-- dresses a plain body in a club kit with a shirt number
local function dressKit(model, teamId, number)
	local def = Teams.list[teamId]
	for _, c in model:GetChildren() do
		if c:IsA("Shirt") or c:IsA("Pants") or c:IsA("ShirtGraphic") then
			c:Destroy()
		end
	end
	local colors = model:FindFirstChildOfClass("BodyColors")
	if colors then
		colors.TorsoColor3 = def.primary
		colors.LeftLegColor3 = def.secondary
		colors.RightLegColor3 = def.secondary
	end
	for _, name in { "UpperTorso", "LowerTorso" } do
		local p = model:FindFirstChild(name)
		if p then
			p.Color = def.primary
		end
	end
	for _, name in { "LeftUpperLeg", "LeftLowerLeg", "LeftFoot", "RightUpperLeg", "RightLowerLeg", "RightFoot" } do
		local p = model:FindFirstChild(name)
		if p then
			p.Color = def.secondary
		end
	end
	local torso = model:FindFirstChild("UpperTorso")
	if torso and number then
		local gui = make("SurfaceGui", { Face = Enum.NormalId.Front, CanvasSize = Vector2.new(100, 100), LightInfluence = 1 }, torso)
		text({ Position = UDim2.fromScale(0.3, 0.15), Size = UDim2.fromScale(0.4, 0.45), Text = tostring(number), FontFace = FONT.num, TextScaled = true, TextColor3 = contrast(def.primary) }, gui)
	end
end

-- a ViewportFrame with a posed player in it; set(source) swaps who is shown
function Menu.avatar(parent, props, yaw)
	local vp = make("ViewportFrame", {
		BackgroundTransparency = 1,
		Ambient = Color3.fromRGB(150, 140, 205),
		LightColor = Color3.fromRGB(255, 246, 236),
		LightDirection = Vector3.new(-0.5, -1, -0.7),
	}, parent)
	for key, value in props do
		vp[key] = value
	end
	local worldModel = make("WorldModel", {}, vp)
	local cam = make("Camera", { FieldOfView = 26 }, vp)
	vp.CurrentCamera = cam
	local holder = { vp = vp }

	-- source: "me" for your own character, or { team = id, number = n, ball = bool }
	function holder.set(source)
		holder.source = source
		worldModel:ClearAllChildren()
		local model
		if source == "me" then
			local char = player.Character
			if not char or not char:FindFirstChild("HumanoidRootPart") then
				return
			end
			char.Archivable = true
			local ok, copy = pcall(function()
				return char:Clone()
			end)
			model = ok and copy or nil
		else
			local template = shared:FindFirstChild("MenuModel")
			model = template and template:Clone()
			if model then
				dressKit(model, source.team, source.number)
			end
		end
		if not model then
			return
		end
		local hum = prepareModel(model)
		model:PivotTo(CFrame.Angles(0, math.pi + (yaw or 0.3), 0))
		model.Parent = worldModel
		if source ~= "me" and source.ball then
			make("Part", { Shape = Enum.PartType.Ball, Size = Vector3.one * 1.2, Color = Color3.fromRGB(255, 214, 64), Anchored = true, CFrame = model:GetPivot() * CFrame.new(0, -0.2, -1.1) }, worldModel)
		end
		local cf, size = model:GetBoundingBox()
		local h = math.max(size.Y, 4)
		local dist = (h * 0.56) / math.tan(math.rad(cam.FieldOfView / 2))
		cam.CFrame = CFrame.lookAt(cf.Position + Vector3.new(0, h * 0.04, dist), cf.Position + Vector3.new(0, h * 0.04, 0))
		if hum then
			local animator = hum:FindFirstChildOfClass("Animator") or make("Animator", {}, hum)
			local anim = make("Animation", { AnimationId = shared:GetAttribute("PackIdle") or "rbxassetid://507766666" })
			local ok, track = pcall(animator.LoadAnimation, animator, anim)
			if ok and track then
				track.Looped = true
				track:Play()
			end
		end
	end
	return holder
end

